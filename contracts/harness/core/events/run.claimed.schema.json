{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/run.claimed.schema.json",
  "title": "RunClaimedEvent",
  "description": "A worker claimed the run; Node appends it in the claim transaction.",
  "x-writer": [
    "node"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "run.claimed"
    },
    "writer": {
      "const": "node"
    },
    "data": {
      "$ref": "#/$defs/RunClaimedData"
    }
  },
  "$defs": {
    "RunClaimedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "fence",
        "leaseMs"
      ],
      "properties": {
        "attempt": {
          "$ref": "../common.schema.json#/$defs/PosInt"
        },
        "fence": {
          "$ref": "../common.schema.json#/$defs/PosInt"
        },
        "leaseMs": {
          "$ref": "../common.schema.json#/$defs/PosInt"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "run.claimed",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "node",
      "visibility": "owner",
      "data": {
        "attempt": 1,
        "fence": 1,
        "leaseMs": 30000
      }
    }
  ]
}
