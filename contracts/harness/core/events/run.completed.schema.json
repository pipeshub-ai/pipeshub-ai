{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/run.completed.schema.json",
  "title": "RunCompletedEvent",
  "description": "Terminal: run completed.",
  "x-writer": [
    "node"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "run.completed"
    },
    "writer": {
      "const": "node"
    },
    "data": {
      "$ref": "#/$defs/RunCompletedData"
    }
  },
  "$defs": {
    "RunCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "$ref": "../common.schema.json#/$defs/CompletedOutcome"
        },
        "truncatedBy": {
          "description": "Set when a limit cut the run's work short and it answered from what it had gathered (BUDGETEND).",
          "$ref": "../common.schema.json#/$defs/CutShortReason"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "run.completed",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "node",
      "visibility": "owner",
      "data": {
        "outcome": "answered"
      }
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "run.completed",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "node",
      "visibility": "owner",
      "data": {
        "outcome": "needs_input"
      }
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "run.completed",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "node",
      "visibility": "owner",
      "data": {
        "outcome": "answered",
        "truncatedBy": "budget"
      }
    }
  ]
}
