{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/session.participant_changed.schema.json",
  "title": "SessionParticipantChangedEvent",
  "description": "A person's role in a session changed (ARCHITECTURE 4.9 Audit; SS1): shared with them (prevRole none), unshared (role none), or their role changed. One event per person. Node writes it on the session's root stream, with no runId, in the transaction that changes the participants; no fold reads it.",
  "x-writer": [
    "node"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "session.participant_changed"
    },
    "writer": {
      "const": "node"
    },
    "data": {
      "$ref": "#/$defs/SessionParticipantChangedData"
    }
  },
  "$defs": {
    "SessionParticipantChangedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "subject",
        "role",
        "prevRole"
      ],
      "properties": {
        "by": {
          "$ref": "../common.schema.json#/$defs/PrincipalRef",
          "description": "Who changed it: the caller of the share route, from its verified credential."
        },
        "subject": {
          "$ref": "../common.schema.json#/$defs/PrincipalRef",
          "description": "Whose role changed."
        },
        "role": {
          "$ref": "#/$defs/ParticipantRole",
          "description": "The role from now on."
        },
        "prevRole": {
          "$ref": "#/$defs/ParticipantRole",
          "description": "The role until now."
        }
      }
    },
    "ParticipantRole": {
      "description": "A non-owner participant's role; none = not a participant.",
      "enum": [
        "none",
        "viewer",
        "collaborator"
      ]
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 3,
      "type": "session.participant_changed",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-03T12:00:00.123Z",
      "writer": "node",
      "visibility": "shared",
      "data": {
        "by": "p_owner1",
        "subject": "p_user2",
        "role": "viewer",
        "prevRole": "none"
      }
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 4,
      "type": "session.participant_changed",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-03T12:00:00.123Z",
      "writer": "node",
      "visibility": "shared",
      "data": {
        "by": "p_owner1",
        "subject": "p_user2",
        "role": "collaborator",
        "prevRole": "viewer"
      }
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 9,
      "type": "session.participant_changed",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-03T12:00:00.123Z",
      "writer": "node",
      "visibility": "shared",
      "data": {
        "by": "p_owner1",
        "subject": "p_user2",
        "role": "none",
        "prevRole": "collaborator"
      }
    }
  ]
}
