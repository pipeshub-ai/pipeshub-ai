{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/run.resumed.schema.json",
  "title": "RunResumedEvent",
  "description": "Suspended run re-queued.",
  "x-writer": [
    "node"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "run.resumed"
    },
    "writer": {
      "const": "node"
    },
    "data": {
      "$ref": "#/$defs/RunResumedData"
    }
  },
  "$defs": {
    "RunResumedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause"
      ],
      "properties": {
        "cause": {
          "enum": [
            "resolved",
            "timer_fired",
            "event_matched",
            "child_done",
            "version_available"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "run.resumed",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "node",
      "visibility": "owner",
      "data": {
        "cause": "resolved"
      }
    }
  ]
}
