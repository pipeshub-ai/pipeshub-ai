{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/verification.recorded.schema.json",
  "title": "VerificationRecordedEvent",
  "description": "G-05 (GA-04): the run's verify gate checked what the run did when it said it was done. verified: every check passed; unverified: at least one failed, each with its reason in plain words. continuing: the run was told what failed and works on (onFail continue); otherwise this is the run's verification and it rides the run's terminal commit. Folds ignore it; Node keeps the latest on the run.",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "verification.recorded"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/VerificationRecordedData"
    }
  },
  "$defs": {
    "VerificationRecordedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "round",
        "checks",
        "continuing"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "round": {
          "$ref": "../common.schema.json#/$defs/PosInt"
        },
        "continuing": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "passed"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "file",
                  "json_schema",
                  "citations",
                  "command"
                ]
              },
              "target": {
                "description": "What the check looked at: a workspace path or the command's first word.",
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "passed": {
                "type": "boolean"
              },
              "reason": {
                "description": "Why it failed, in plain words; absent when it passed.",
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 21,
      "runId": "run_1",
      "type": "verification.recorded",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-31T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "data": {
        "status": "verified",
        "round": 1,
        "continuing": false,
        "checks": [
          {
            "kind": "file",
            "target": "out/report.pdf",
            "passed": true
          }
        ]
      },
      "attemptId": "att_1",
      "fence": 3
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 22,
      "runId": "run_1",
      "type": "verification.recorded",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-31T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "data": {
        "status": "unverified",
        "round": 2,
        "continuing": false,
        "checks": [
          {
            "kind": "command",
            "target": "pytest",
            "passed": false,
            "reason": "The command exited with code 1."
          },
          {
            "kind": "citations",
            "passed": false,
            "reason": "The answer quotes \"net revenue rose 40%\" beside [ref2], and that text is not in the source."
          }
        ]
      },
      "attemptId": "att_1",
      "fence": 3
    }
  ]
}
