{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/message.completed.schema.json",
  "title": "MessageCompletedEvent",
  "description": "A message finished streaming.",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "message.completed"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/MessageCompletedData"
    }
  },
  "$defs": {
    "MessageCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "textRef",
        "isFinal"
      ],
      "properties": {
        "role": {
          "enum": [
            "assistant",
            "user",
            "system"
          ]
        },
        "textRef": {
          "$ref": "../common.schema.json#/$defs/ContentRef"
        },
        "isFinal": {
          "type": "boolean"
        },
        "injected": {
          "type": "boolean",
          "description": "A message the loop injected (a recovery nudge), not one the user sent."
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "message.completed",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "data": {
        "role": "assistant",
        "textRef": {
          "ref": "cas/t1",
          "hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "size": 10
        },
        "isFinal": true
      },
      "attemptId": "att_1",
      "fence": 3
    }
  ]
}
