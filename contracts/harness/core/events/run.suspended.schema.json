        "interactionId": "int_1"
      }
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "run.suspended",
      "schemaVersion": 1,
      "critical": true,
