{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/core/events/context.cleared.schema.json",
  "title": "ContextClearedEvent",
  "description": "Range cleared from context; clearing never lowers the context label.",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "context.cleared"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/ContextClearedData"
    }
  },
  "$defs": {
    "ContextClearedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range"
      ],
      "properties": {
        "range": {
          "$ref": "../common.schema.json#/$defs/SeqRange"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "type": "context.cleared",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "data": {
        "range": {
          "fromSeq": 3,
          "toSeq": 40
        }
      },
      "attemptId": "att_1",
      "fence": 3
    }
  ]
}
