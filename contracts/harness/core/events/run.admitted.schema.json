      "writer": "node",
      "visibility": "owner",
      "data": {
        "runKind": "child",
        "principalRef": "p_u42",
        "parentRunId": "run_0"
      }
    },
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 9,
      "runId": "run_2",
      "type": "run.admitted",
      "schemaVersion": 1,
      "critical": true,
      "ts": "2026-10-04T12:00:00.123Z",
