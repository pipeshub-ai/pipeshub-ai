    },
    {
      "path": "engineProfile.approvals.write",
      "kind": "ceiling",
      "order": {
        "kind": "rank-raise",
        "ranks": [
          [
            "allow"
          ],
          [
            "ask"
          ],
          [
            "deny"
          ]
        ]
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "The decision before a gateway tool of class write runs."
    },
    {
      "path": "engineProfile.approvals.execute",
      "kind": "ceiling",
      "order": {
        "kind": "rank-raise",
        "ranks": [
          [
            "allow"
          ],
          [
            "ask"
          ],
          [
