    {
      "path": "rollout.CONTROL_PLANE_CAPABILITIES",
      "kind": "ceiling",
      "order": {
        "kind": "bool-and"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "Whether the org's capabilities are recorded as migrated to the control plane, so a run's effective set is the authority for its items. No layer above the org sets it and the release holds none: a pin without the row reads as not migrated."
    },
    {
      "path": "catalog.approval",
      "kind": "ceiling",
      "order": {
        "kind": "rank-raise-rules",
        "ranks": [
          [
            "none"
          ],
          [
            "owner"
          ],
          [
            "teamAdmin"
          ],
          [
            "orgAdmin"
          ]
        ]
      },
      "exposure": [
        "deployment",
        "org",
        "team"
      ],
      "description": "Who approves a configuration change (02-lld §2.6, §3.3), per rule `{change}:{kind}` (`*` for every kind): none < owner < teamAdmin < orgAdmin. A layer below may only raise a rule; a rule for `change:*` also binds every kind of that change. No rule: the workflow's default (owner for a user's object, teamAdmin for a team's, orgAdmin for the org's)."
    },
    {
      "path": "catalog.delegation",
      "kind": "ceiling",
      "order": {
        "kind": "subset"
      },
      "exposure": [
        "org"
      ],
      "description": "The control-plane actions an org delegates to the admins (OWNER role) of a team, on that team's own objects (FR-21). Unset: nothing is delegated; the org must name each action."
    },
    {
      "path": "toolDisclosure.modes",
      "kind": "ceiling",
      "order": {
        "kind": "subset"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request"
      ],
      "description": "The tool-disclosure modes an agent may pick (C5.01): eager, lazy, filesystem; null is any."
    },
    {
      "path": "toolDisclosure.mode",
      "kind": "choice",
      "within": "toolDisclosure.modes",
      "exposure": [
        "org",
        "team",
        "agent"
      ],
      "description": "How the run's tools reach the model (C5.01): eager lists every granted tool, lazy finds the rest through search_tools and call_tool, filesystem describes them in /pipeshub/tools. Unset, each executor keeps its own default."
    },
    {
      "path": "snapshots.ttlDays",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "How long an engine's sandbox snapshot is kept, in days, before the retention sweeper deletes it; no run restores an older one (OWD-12). The release keeps them 7 days; the deployment or the org may keep them shorter."
    },
    {
      "path": "triggers.webhookMaxBytes",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "The largest body a webhook trigger accepts, in bytes (TR-04); a larger one is refused before it is read further. The release accepts 256 KiB; the deployment or the org may accept less."
    },
    {
      "path": "triggers.webhookPerMinute",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "Authenticated deliveries one webhook trigger takes per minute (TR-04); more are refused with a retry time. Coalescing still makes one run per window. The release takes 30; the deployment or the org may take fewer."
    },
    {
      "path": "triggers.notifyChannels",
      "kind": "ceiling",
      "order": {
        "kind": "subset"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "Where a schedule's actor may be told that a run ended (TR-07): in_app, email, slack. Each schedule picks among them; email and Slack carry the schedule, the outcome and a link, never the answer."
    },
    {
      "path": "quotas.activeRunsPerOrg",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "Runs one org may have queued or running at once (C4.10, P1.14); one more is refused with a retry time. The release allows 200; the deployment or the org may allow fewer."
    },
    {
      "path": "quotas.activeRunsPerUser",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org"
      ],
      "description": "Runs one person may have queued or running at once in an org (C4.10, P1.14). The release allows 10; the deployment or the org may allow fewer."
    },
    {
      "path": "toolResults.maxChars",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request"
      ],
      "description": "The most characters of one tool result the model reads inline (C4.10, TG-11); past it the result is cut head and tail with how to get the rest, or offloaded to a file in the sandbox (/pipeshub/knowledge). null: each executor's own cap (the loop 64,000, an engine 24,000); a set value lowers both."
    },
    {
      "path": "toolResults.formats",
      "kind": "ceiling",
      "order": {
        "kind": "subset"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request"
      ],
      "description": "The response_format values an agent may default to (C4.10, WP-12): concise, detailed; null is any."
    },
    {
      "path": "toolResults.format",
      "kind": "choice",
      "within": "toolResults.formats",
      "exposure": [
        "org",
        "team",
        "agent"
      ],
      "description": "The response_format a knowledge search uses when the model names none (C4.10, WP-12): concise returns the most relevant passages within a smaller budget, detailed the full budget. Unset: concise."
    },
    {
      "path": "interactions.waitS",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request"
      ],
      "description": "How long a run waits for a person's answer to an approval or a question before it ends as expired (C4.10, AP-07). null: the deployment's HARNESS_WAIT_FOR_PERSON_DAYS (7 days)."
    },
    {
      "path": "interactions.conversationGrants",
