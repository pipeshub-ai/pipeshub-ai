{
  "schemaVersion": 1,
  "description": "The policy dimensions (R2 CP3). Row order is refusal order. `engineProfile.*` rows are E4a's engine-profile narrowing, in its refusal order; `access` and `resultSchema` are set by the host only. Generated as POLICY_DIMENSIONS in every target.",
  "dimensions": [
    {
      "path": "engineProfile.engine",
      "kind": "ceiling",
      "order": {
        "kind": "admits"
      },
      "narrowedBy": "engineProfile.engines",
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "The engine build the run uses; a layer admits engines by `kind` or `kind@version` selectors and the first release engine every layer admits runs (E4a)."
    },
    {
      "path": "engineProfile.access",
      "kind": "ceiling",
      "order": {
        "kind": "flat"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "The model access route the run is pinned to; a narrowing may only name the same route. Set by the host, never by a wire layer."
    },
    {
      "path": "engineProfile.mode",
      "kind": "ceiling",
      "order": {
        "kind": "tree",
        "children": {
          "build": [
            "plan",
            "review"
          ]
        }
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "plan and review read and report; build edits. build narrows to either; plan and review only to themselves."
    },
    {
      "path": "engineProfile.isolationMin",
      "kind": "ceiling",
      "order": {
        "kind": "rank-raise",
        "ranks": [
          [
            "docker"
          ],
          [
            "gvisor",
            "k8s",
            "managed"
          ],
          [
            "microvm"
          ]
        ]
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "The weakest sandbox runtime the run accepts; a narrowing may only raise it."
    },
    {
      "path": "engineProfile.egress",
      "kind": "ceiling",
      "order": {
        "kind": "flat",
        "bottom": "none"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "Network beyond the gateways: none, or one named allowlist, which narrows only to itself or to none."
    },
    {
      "path": "engineProfile.tools.maxTools",
      "kind": "ceiling",
      "order": {
        "kind": "min"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "How many gateway tools the run may be granted; null is unlimited."
    },
    {
      "path": "engineProfile.tools.effects",
      "kind": "ceiling",
      "order": {
        "kind": "subset"
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "The effect classes of the gateway tools the run may be granted."
