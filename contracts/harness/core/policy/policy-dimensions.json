    },
    {
      "path": "engineProfile.subAgents",
      "kind": "ceiling",
      "order": {
        "kind": "gated",
        "switch": "enabled",
        "bounds": [
          "maxDepth",
          "maxConcurrent"
        ],
        "off": {
          "enabled": false,
          "maxDepth": 1,
          "maxConcurrent": 1
        }
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "The engine's own sub-agents: off, or on with a depth and a concurrency bound."
    },
    {
      "path": "engineProfile.reasoningEffort",
      "kind": "ceiling",
      "order": {
        "kind": "rank",
        "ranks": [
          [
            "low"
          ],
          [
            "medium"
          ],
          [
            "high"
          ]
        ]
      },
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
