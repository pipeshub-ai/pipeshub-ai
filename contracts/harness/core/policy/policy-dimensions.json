        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "request",
        "live"
      ],
      "description": "Tokens the run may spend; an engine profile's limits.maxTokens narrows it."
    },
    {
      "path": "budgets.maxCostUsd",
