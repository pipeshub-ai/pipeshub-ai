      "kind": "choice",
      "within": "models.routes",
      "exposure": [
        "org",
        "team",
        "agent",
        "user",
        "trigger",
        "parent",
        "request"
      ],
      "description": "The model each named role calls: a sub-agent role's child run (MA1), and the run's own engine roles under the reserved keys fast, subagent and compaction (GA-15); a role without one calls the run's."
    },
    {
      "path": "models.roleCostCeilings",
      "kind": "ceiling",
