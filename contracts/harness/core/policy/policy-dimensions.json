      "widening": "meet",
      "exposure": [
        "deployment",
        "org",
        "team",
        "agent",
        "trigger",
        "parent",
        "live"
      ],
      "description": "The most a sub-agent role's model may cost, in USD per 1M tokens (input plus output list price, short-context tier), per role key; `default` bounds every role (MA1)."
