{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/api/model-account.schema.json",
  "title": "ModelAccount",
  "description": "A model account as the settings pages read it (P2.4b): metadata only, never a key, at most its last four characters. Answered by `PUT /model-accounts/me/{provider}`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "accountRef", "provider", "label", "last4", "version", "createdAt", "rotatedAt", "validation"],
  "properties": {
    "id": {
      "description": "The path id: the provider for a user's key, the account id for an org cloud account.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "accountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "accountId"],
      "properties": {
        "kind": {"$ref": "#/$defs/ModelAccountKind"},
        "accountId": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "label": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "last4": {
      "description": "The key's last four characters (printable ASCII), or empty.",
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{0,4}$"
    },
    "version": {"$ref": "../../../core/common.schema.json#/$defs/PosInt"},
    "createdAt": {"type": "string", "minLength": 1},
    "rotatedAt": {"type": "string", "minLength": 1},
    "validation": {
      "description": "`unvalidated` until a provider check exists (P2.4b D-3).",
      "const": "unvalidated"
    }
  },
  "$defs": {
    "ModelAccountKind": {
      "description": "A stored account: a user's own key, or an org's cloud account.",
      "x-constant": "MODEL_ACCOUNT_KINDS",
      "enum": ["user_api_key", "org_cloud"]
    }
  },
  "examples": [
    {
      "id": "openai",
      "accountRef": {"kind": "user_api_key", "accountId": "users/u1/openai"},
      "provider": "openai",
      "label": null,
      "last4": "x9Qz",
      "version": 1,
      "createdAt": "2026-10-09T00:00:00.000Z",
      "rotatedAt": "2026-10-09T00:00:00.000Z",
      "validation": "unvalidated"
    },
    {
      "id": "acct_1",
      "accountRef": {"kind": "org_cloud", "accountId": "cloud/acct_1"},
      "provider": "azureOpenAI",
      "label": "Prod",
      "last4": "",
      "version": 3,
      "createdAt": "2026-10-01T00:00:00.000Z",
      "rotatedAt": "2026-10-08T00:00:00.000Z",
      "validation": "unvalidated"
    }
  ]
}
