{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.repository.fetched.schema.json",
  "title": "PipeshubRepositoryFetchedEvent",
  "description": "A public repository the run's person allowed, fetched by the worker outside the sandbox and handed to it read-only (repository_fetch, WP-63 part A), journaled with the call's outcome: the host, the repository's path, the bytes handed over (what counts against the run's outside traffic), whether the deployment's cache served it, whether the whole history was asked for, and the commit. The run's activity shows it as a line and the audit chain records it. Written only to a journal whose claim names repository_fetches. Folds ignore it.",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.repository.fetched"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/PipeshubRepositoryFetchedData"
    }
  },
  "$defs": {
    "PipeshubRepositoryFetchedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "repository",
        "bytes",
        "cached",
        "full"
      ],
      "properties": {
        "host": {
          "description": "The git host, by name.",
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "repository": {
          "description": "The repository's path on the host (owner/name, or a group path), without .git.",
          "type": "string",
          "maxLength": 300,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_][A-Za-z0-9._-]{0,99}){1,7}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17179869184
        },
        "cached": {
          "type": "boolean"
        },
        "full": {
          "type": "boolean"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 9,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-11-01T12:00:00.123Z",
      "visibility": "owner",
      "writer": "worker",
      "type": "x.pipeshub.repository.fetched",
      "data": {
        "host": "github.com",
        "repository": "onyx-dot-app/onyx",
        "bytes": 44040192,
        "cached": false,
        "full": false,
        "commit": "4f83564c1f0e8596be3f71d78f847a96447a3bdd"
      }
    }
  ]
}
