{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.schedule.created.schema.json",
  "title": "PipeshubScheduleCreatedEvent",
  "description": "A schedule the run's person approved in chat was made (ADR-SCH-01 D3), journaled by Node once, when it makes it. It makes the approval single-use: a later request of the same interaction answers this schedule while it exists and is refused once it was deleted, so a deleted schedule is never made again. Ids only. Audited; folds ignore it.",
  "x-writer": [
    "node"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.schedule.created"
    },
    "writer": {
      "const": "node"
    },
    "data": {
      "$ref": "#/$defs/PipeshubScheduleCreatedData"
    }
  },
  "$defs": {
    "PipeshubScheduleCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactionId",
        "scheduleId"
      ],
      "properties": {
        "interactionId": {
          "$ref": "../../../core/common.schema.json#/$defs/Id"
        },
        "scheduleId": {
          "$ref": "../../../core/common.schema.json#/$defs/Id"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 14,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-11-27T12:00:00.123Z",
      "visibility": "audit",
      "writer": "node",
      "type": "x.pipeshub.schedule.created",
      "data": {
        "interactionId": "ix.approve.k7653147571b6e391911ef030c4f92bd1b96d9004",
        "scheduleId": "sch_0123456789abcdef0123456789abcdef"
      }
    }
  ]
}
