{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.tool.unavailable.schema.json",
  "title": "PipeshubToolUnavailableEvent",
  "description": "Tools a search_tools call found that exist but this agent cannot call (not attached, not authenticated, MCP unavailable), shown as the legacy tool_unavailable frames; journaled with the call's outcome. Presentation only (non-critical).",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.tool.unavailable"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/PipeshubToolUnavailableData"
    }
  },
  "$defs": {
    "PipeshubToolUnavailableData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId",
        "hits"
      ],
      "properties": {
        "callId": {
          "$ref": "../../../core/common.schema.json#/$defs/Text"
        },
        "hits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/PipeshubUnavailableTool"
          }
        }
      }
    },
    "PipeshubUnavailableTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "toolset",
        "reason",
        "message"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "toolset": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "type": "x.pipeshub.tool.unavailable",
      "data": {
        "callId": "call_1",
        "hits": [
          {
            "tool": "crm__close_deal",
            "toolset": "crm",
            "reason": "not_attached",
            "message": "Close a CRM deal."
          }
        ]
      },
      "attemptId": "att_1",
      "fence": 3
    }
  ]
}
