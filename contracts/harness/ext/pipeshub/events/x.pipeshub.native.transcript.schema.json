{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.native.transcript.schema.json",
  "title": "PipeshubNativeTranscriptEvent",
  "description": "A part of an engine turn's native transcript (C2.39, UP-07): every input its adapter's mapper took, each native message as its JSON value and the session's calls on the mapper, as JSON lines sealed in the run's content store, so the turn's canonical events can be regenerated by re-parsing it. Never shown. Non-critical: the fold and the chat ignore it. Written only when the claim's Node lists native_events.",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.native.transcript"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/PipeshubNativeTranscriptData"
    }
  },
  "$defs": {
    "PipeshubNativeTranscriptData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnId",
        "part",
        "lines",
        "sizeBytes",
        "final",
        "truncated",
        "content"
      ],
      "properties": {
        "turnId": {
          "$ref": "../../../core/common.schema.json#/$defs/Id",
          "description": "The engine turn (turn_id_for(run, index)): the same on every attempt of the turn."
        },
        "part": {
          "$ref": "../../../core/common.schema.json#/$defs/UInt",
          "description": "The part's place in the turn's transcript, from 0."
        },
        "lines": {
          "$ref": "../../../core/common.schema.json#/$defs/UInt"
        },
        "sizeBytes": {
          "$ref": "../../../core/common.schema.json#/$defs/UInt"
        },
        "final": {
          "type": "boolean",
          "description": "The turn's last part."
        },
        "truncated": {
          "type": "boolean",
          "description": "On the final part: the turn's transcript passed its bound and later lines were not kept."
        },
        "content": {
          "$ref": "../../../core/common.schema.json#/$defs/ContentRef",
          "description": "The part's JSON lines, sealed in the run's content store (erased with the conversation)."
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "attemptId": "att_1",
      "fence": 3,
      "type": "x.pipeshub.native.transcript",
      "data": {
        "turnId": "trn_1",
        "part": 0,
        "lines": 31,
        "sizeBytes": 412,
        "final": true,
        "truncated": false,
        "content": {
          "ref": "sealed:org_1/ses_1/c1",
          "hash": "sha256:abababababababababababababababababababababababababababababababab",
          "size": 412
        }
      }
    }
  ]
}
