{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.goal.presented.schema.json",
  "title": "PipeshubGoalPresentedEvent",
  "description": "The goal a run's pre-run steps settled on (the legacy intent rewrite, or the query itself), as the stream shows it in goal_description; journaled with the pre-run commit. Presentation only (non-critical).",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.goal.presented"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/PipeshubGoalPresentedData"
    }
  },
  "$defs": {
    "PipeshubGoalPresentedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "type": "x.pipeshub.goal.presented",
      "data": {
        "description": "Look up support ticket T-42 and report its status and owner."
      },
      "attemptId": "att_1",
      "fence": 3
    }
  ]
}
