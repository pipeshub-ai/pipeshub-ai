{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.telemetry.recorded.schema.json",
  "title": "PipeshubTelemetryRecordedEvent",
  "description": "An opt-in measurement frame of a run admitted with includeRetrievalContext (SYNC2-F1): `retrieval_context` (the records and block indices that reached the model after the prefetch or one tool call; identifiers only, never block text) or `run_usage` (the run's token totals and loop outcome), as today's loop streams them (app/agents/agent_loop/protocol/retrieval_context.py, run_usage.py). The projector shows `value` to the run's owner as the CUSTOM frame `name`. Presentation only (non-critical); the fold ignores it.",
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.telemetry.recorded"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/PipeshubTelemetryRecordedData"
    }
  },
  "$defs": {
    "PipeshubTelemetryRecordedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "enum": [
            "retrieval_context",
            "run_usage"
          ]
        },
        "value": {
          "type": "object",
          "description": "The frame's payload as today's loop sends it (RetrievalContextPayload or RunUsagePayload, wire form)."
        }
      }
    }
  },
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 7,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-10-01T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "attemptId": "att_1",
      "fence": 3,
      "type": "x.pipeshub.telemetry.recorded",
      "data": {
        "name": "retrieval_context",
        "value": {
          "schemaVersion": 1,
          "seq": 1,
          "source": "tool",
          "status": "ok",
          "toolName": "search_internal_knowledge",
          "toolCallId": "c1",
          "records": [
            {
              "virtualRecordId": "vr_1",
              "blockIndices": [
                0,
                3
              ],
              "summaryHit": false,
              "fetched": []
            }
          ],
          "knownRecordIds": [],
          "cumulativeBlocks": 2,
          "cumulativeRecords": 1
        }
      }
    }
  ]
}
