{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pipeshub.com/harness/v2/ext/pipeshub/events/x.pipeshub.outcome.recorded.schema.json",
  "title": "PipeshubOutcomeRecordedEvent",
  "description": "ADR-RUN-01 D1: facts of the run's outcome ledger as the worker learned them (a file written, a source gathered, a note kept, a step completed, a limit reached, a child ended, a save refused), journaled with the turn's commit; the run's ledger is the fold of these events, and a run journaled before them replays its ledger from its other events. Written only when the claim's journal accepts outcome_ledger. Non-critical; the run's own folds ignore it.",
  "examples": [
    {
      "orgId": "org_1",
      "sessionId": "ses_1",
      "streamId": "ses_1",
      "seq": 12,
      "runId": "run_1",
      "schemaVersion": 1,
      "critical": false,
      "ts": "2026-11-05T12:00:00.123Z",
      "writer": "worker",
      "visibility": "owner",
      "type": "x.pipeshub.outcome.recorded",
      "data": {
        "facts": [
          {
            "kind": "source_gathered",
            "ref": "https://docs.onyx.app/connectors",
            "tool": "fetch_url",
            "url": "https://docs.onyx.app/connectors",
            "title": "Connectors"
          },
          {
            "kind": "artifact_written",
            "path": "out/report.md",
            "revision": 7,
            "bytes": 143210,
            "state": "draft",
            "by": "engine"
          },
          {
            "kind": "note_saved",
            "path": "notes/handoff.json"
          },
          {
            "kind": "step_completed",
            "turn": 1
          },
          {
            "kind": "limit_reached",
            "limit": "time"
          },
          {
            "kind": "child_ended",
            "runId": "run_2",
            "status": "failed"
          },
          {
            "kind": "save_refused",
            "reason": "WORKSPACE_TOO_LARGE"
          }
        ]
      }
    }
  ],
  "x-writer": [
    "worker"
  ],
  "allOf": [
    {
      "$ref": "../../../core/envelope.schema.json#/$defs/InlineEnvelope"
    }
  ],
  "properties": {
    "type": {
      "const": "x.pipeshub.outcome.recorded"
    },
    "writer": {
      "const": "worker"
    },
    "data": {
      "$ref": "#/$defs/PipeshubOutcomeRecordedData"
    }
  },
  "$defs": {
    "PipeshubOutcomeRecordedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/OutcomeFact"
          }
        }
      }
    },
    "OutcomeFact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "revision",
            "state",
            "by"
          ],
          "properties": {
            "kind": {
              "const": "artifact_written"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "revision": {
              "$ref": "../../../core/common.schema.json#/$defs/UInt"
            },
            "bytes": {
              "$ref": "../../../core/common.schema.json#/$defs/UInt"
            },
            "state": {
              "enum": [
                "placeholder",
                "draft",
                "final"
              ]
            },
            "by": {
              "enum": [
                "engine",
                "wrap_up"
              ],
              "description": "engine: the engine wrote it; wrap_up: the run wrote it in place of a missing deliverable."
            }
          },
          "description": "A file the run wrote for the person (under out/, or named as the deliverable) at a workspace revision; bytes absent when unknown."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref",
            "tool"
          ],
          "properties": {
            "kind": {
              "const": "source_gathered"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "title": {
              "type": "string",
              "maxLength": 300
            }
          },
          "description": "A tool result the run gathered: ref is the page's URL when it has one, else tool:argsDigest."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "note_saved"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "description": "A note kept for the person or the run that continues (the handoff, the partial answer, the engine's notes)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "turn"
          ],
          "properties": {
            "kind": {
              "const": "step_completed"
            },
            "turn": {
              "$ref": "../../../core/common.schema.json#/$defs/PosInt"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "limit"
          ],
          "properties": {
            "kind": {
              "const": "limit_reached"
            },
            "limit": {
              "enum": [
                "budget",
                "turns",
                "time",
                "stall",
                "provider",
                "engine_error",
                "secret_blocked"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "runId",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "child_ended"
            },
            "runId": {
              "$ref": "../../../core/common.schema.json#/$defs/Id"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "save_refused"
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            }
          },
          "description": "The workspace store refused a save; the last saved revision stands (ADR-RUN-01 D6)."
        }
      ]
    }
  }
}
