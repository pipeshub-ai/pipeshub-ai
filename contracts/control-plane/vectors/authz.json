{
  "description": "Authorizer matrix (CPA-16, 03-interfaces \u00a75.1): role (member, agent editor, team admin, delegated team admin, org admin, owner) x action x resource scope. `world` gives each user's live org role, team memberships and the agents they edit; `delegation` is the org's catalog.delegation for the case. Read by the Node RoleAuthorizer tests (CPD-9).",
  "orgId": "org-a",
  "world": {
    "roles": {
      "u-admin": "admin",
      "u-member": "member",
      "u-team-admin": "member",
      "u-team-reader": "member",
      "u-editor": "member",
      "u-other-team-admin": "member"
    },
    "teams": {
      "u-team-admin": [
        {
          "teamId": "t9",
          "role": "OWNER"
        }
      ],
      "u-team-reader": [
        {
          "teamId": "t9",
          "role": "READER"
        }
      ],
      "u-other-team-admin": [
        {
          "teamId": "t1",
          "role": "OWNER"
        }
      ]
    },
    "agents": {
      "a7": {
        "editors": [
          "u-editor"
        ],
        "ownerTeam": "t9"
      },
      "a8": {
        "editors": [
          "u-editor"
        ],
        "ownerTeam": null
      }
    }
  },
