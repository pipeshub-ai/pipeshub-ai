# pgBackRest settings for docker-compose.postgres-backup.yml. Copy to pgbackrest.env (chmod 600: it can hold storage keys and the
# encryption passphrase). Any pgBackRest option can be set here as PGBACKREST_<OPTION> (upper case, - as _), for example
# repo1-retention-full as PGBACKREST_REPO1_RETENTION_FULL. Options: https://pgbackrest.org/configuration.html

# Keep two full backups and the WAL needed to restore to any point since the older one (with the default weekly full backup: 1-2 weeks).
PGBACKREST_REPO1_RETENTION_FULL=2

# Compression of backups and archived WAL (none, bz2, gz, lz4, zst).
PGBACKREST_COMPRESS_TYPE=zst

# Encrypt the repository. Strongly recommended for any repository off this host. Set it before the first backup and keep the passphrase
# somewhere other than the repository: without it nothing can be restored.
# PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
# PGBACKREST_REPO1_CIPHER_PASS=

# Default repository: the pg_backup_repo Docker volume on this host (or the host directory named by PG_BACKUP_REPO in .env). It protects
# against mistakes and corruption, not against losing this host; use object storage for that. S3 or any S3-compatible store:
# PGBACKREST_REPO1_TYPE=s3
# PGBACKREST_REPO1_PATH=/pipeshub
# PGBACKREST_REPO1_S3_BUCKET=
# PGBACKREST_REPO1_S3_ENDPOINT=s3.amazonaws.com
# PGBACKREST_REPO1_S3_REGION=us-east-1
# PGBACKREST_REPO1_S3_KEY=
# PGBACKREST_REPO1_S3_KEY_SECRET=
# PGBACKREST_REPO1_S3_URI_STYLE=path        # most S3-compatible stores (MinIO, Ceph) need path-style addressing
# Azure Blob (PGBACKREST_REPO1_TYPE=azure) and Google Cloud Storage (gcs) take the repo1-azure-* and repo1-gcs-* options.

# Archiving that cannot reach the repository would keep WAL on the server's volume until it can, so the volume could fill up and stop
# the server. The archive queue is therefore capped at 4GiB unless set here: beyond it pgBackRest drops WAL instead ("pgBackRest will
# notify PostgreSQL that the WAL was successfully archived, then DROP IT ... PITR will not be possible past that point. A new backup will
# be required to regain full restore capability", https://pgbackrest.org/configuration.html#section-archive/option-archive-push-queue-max).
# The server stays up; the pg-backup service turns unhealthy, logs that point-in-time restore has a gap, and takes a full backup at once,
# which closes the gap. Raise the cap to ride out longer outages if the volume has room; set it empty for no cap (the volume can fill).
# After a gap, nothing is expired so the backup before it stays restorable (pg-restore.sh latest --set <label>), until you run
# `scripts/pipeshub-compose.sh exec pg-backup pg-backup.sh clear-gap-hold`, or for at most this many days (then expiry resumes by itself):
# PG_BACKUP_GAP_HOLD_DAYS=14
# PGBACKREST_ARCHIVE_PUSH_QUEUE_MAX=4GiB
