# SECURITY WARNING: Always set NODE_ENV=production in production environments
# to prevent information disclosure vulnerabilities
NODE_ENV=development
LOG_LEVEL=info

ALLOWED_ORIGINS=

# Docker image tag — https://hub.docker.com/r/pipeshubai/pipeshub-ai
# - latest: larger image with a pre-downloaded embedding model; use for air-gapped or VPC deployments without internet
# - slim: smaller image; use with API-based embeddings, or when the model can be downloaded after deploy
IMAGE_TAG=slim

SECRET_KEY=your_random_encryption_secret_key

# Use Public URL (HTTPs only) to open web page
FRONTEND_PUBLIC_URL=

# Graph database passwords. Set the one matching DATA_STORE below.
NEO4J_PASSWORD=your_neo4j_password
ARANGO_PASSWORD=your_arangodb_password

REDIS_PASSWORD=

MONGO_USERNAME=admin
MONGO_PASSWORD=your_mongodb_password
# If MongoDB crash-loops with a segfault (exit 139) on a newer host kernel,
# try the rseq tunable first so the supported MongoDB version can stay pinned.
# MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=1
# Fallback only: pin an older image. MongoDB 8.x data is not readable by 7.x,
# so wipe the mongo volume before downgrading.
# MONGO_IMAGE_TAG=8.0.17
#
# MongoDB resource limits. On shared ~16 GB quickstart hosts, WiredTiger's
# upstream default can reserve several GB, so cache defaults to 1 GB and the
# container limit to 2 GB. Other service memory limits (e.g. APP_MEMORY_LIMIT)
# are OOM caps, not reservations — they are not expected to sum to host RAM.
# Increase Mongo settings on larger/dedicated hosts; avoid decreasing below
# 1 GB unless this is a very small dev workload.
# MONGO_CACHE_GB=1
# MONGO_MEMORY_LIMIT=2G
# APP_MEMORY_LIMIT=10G
#
# Combined memory+swap ceiling for the pipeshub-ai container (not a
# separate swap allowance) — the swap budget is APP_MEMSWAP_LIMIT minus
# APP_MEMORY_LIMIT, so the 10G/16G defaults give 6G of swap. This lets the
# kernel page out memory a co-located idle service (e.g. Docling's model
# weights between documents) is holding but not actively using, instead of
# it permanently counting against the resource governor's MEM_SOFT/MEM_HARD
# thresholds. Must stay >= APP_MEMORY_LIMIT; raise/lower both together to
# change the swap budget.
# APP_MEMSWAP_LIMIT=16G

# HuggingFace offline mode. Leave unset for the default slim image so the
# embedding model can download on first use. Set to 1 on an air-gapped host
# that already has models cached (the full `latest` image bakes them in).
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

QDRANT_API_KEY=your_qdrant_api_key

# ── Backend selection ────────────────────────────────────────────────────────
# Each of these picks a backend. COMPOSE_PROFILES decides which containers
# start. The two must agree: a backend whose profile is missing will not be
# running, and a profile whose backend is not selected starts a container
# nothing connects to.

# Graph database: "neo4j" (default) or "arangodb"
DATA_STORE=neo4j

# KV store: "redis" (no extra container) or "etcd"
KV_STORE_TYPE=redis

# Message broker: "redis" (Redis Streams, no extra container) or "kafka"
MESSAGE_BROKER=redis

# Vector DB collection layout.
#   single              (default) every record in one collection, isolated by
#                       payload filters — the layout every provider recommends.
#   per_connector_type  one collection per connector type (drive_records,
#                       slack_records, ...). Gives each search a smaller
#                       collection and lets one source be re-indexed on its own;
#                       costs a fan-out across collections per search. Bounded
#                       by how many kinds of source you index (~30 at most).
# Changing this on an existing deployment is NOT a config edit: the services
# fail fast on startup, because points already sit in collections the new
# strategy would not resolve. Use the embedding-rebuild procedure.
# VECTOR_COLLECTION_STRATEGY=single

# Profiles for the selections above. Available profiles:
#   graph-neo4j    Neo4j              (pairs with DATA_STORE=neo4j)
#   graph-arango   ArangoDB           (pairs with DATA_STORE=arangodb)
#   kv-etcd        etcd               (pairs with KV_STORE_TYPE=etcd)
#   broker-kafka   Kafka + Zookeeper  (pairs with MESSAGE_BROKER=kafka)
# redis, mongodb and qdrant always start and need no profile.
#
# The values below are the slim stack, matching IMAGE_TAG=slim above: Neo4j for
# the graph, Redis Streams for the broker, Redis for the key-value store. For the
# full stack set MESSAGE_BROKER=kafka, KV_STORE_TYPE=etcd and
# COMPOSE_PROFILES=graph-neo4j,broker-kafka,kv-etcd together.
COMPOSE_PROFILES=graph-neo4j
# Optional: isolate this copy from another PipesHub stack on the same Docker host.
# The installer writes this; --stop / --uninstall read it. Default is pipeshub-ai.
# COMPOSE_PROJECT_NAME=pipeshub-ai
# Redis Streams settings (only used when MESSAGE_BROKER=redis)
REDIS_STREAMS_MAXLEN=500000

# Consumer settings
# Max times a message can be delivered before being dead-lettered (default: 10)
# MAX_DELIVERY_ATTEMPTS=10

# MCP OAuth scopes (comma-separated)
MCP_SCOPES=openid,profile,email,offline_access,semantic:write,conversation:write,conversation:chat,kb:read,team:read,user:read,config:read,agent:read,agent:execute,connector:read


# Worker counts
# Uncomment to pin the query worker count. Left unset so WEB_CONCURRENCY,
# which uvicorn honours by default, still applies if you use it.
# QUERY_UVICORN_WORKERS=1

INDEXING_UVICORN_WORKERS=1
PARSING_UVICORN_WORKERS=1
DOCLING_UVICORN_WORKERS=1
LOCAL_DOCLING_PARSE_WORKERS=1
PDF_OCR_DETECTION_WORKERS=1

# Query-service runtime tuning. These defaults reproduce current behaviour.
# PIPESHUB_AGENT_TRANSPORT: langchain (default) | direct
PIPESHUB_AGENT_TRANSPORT=langchain
# Accessible-records cache is ON unless set to a disabled value; leave blank to keep it on.
PIPESHUB_ACCESSIBLE_RECORDS_CACHE=
PIPESHUB_ACCESSIBLE_RECORDS_CACHE_TTL=300
# 0 disables the signed-URL cache. Keep well under the 3600s signing lifetime.
PIPESHUB_SIGNED_URL_CACHE_SECONDS=0

# Embedding server (local HuggingFace / SentenceTransformer models)
EMBEDDING_SERVER_URL=http://localhost:8002

# Docker json-file log rotation (used by compose logging.driver options)
LOG_MAX_SIZE=20m
LOG_MAX_FILE=15

# Indexing concurrency. Leave unset so new images size from CPU. Hub slim
# crashes on empty strings; compose unsets blanks so slim uses its built-in
# defaults. Set an integer only to cap (not 5/7 as a permanent ceiling).
# MAX_CONCURRENT_PARSING=
# MAX_CONCURRENT_INDEXING=
# MAX_PENDING_INDEXING_TASKS=
# EMBEDDING_SERVER_MAX_CONCURRENCY=
# EMBEDDING_BATCH_CONCURRENCY=
GOVERNOR_HEAVY_PARSE_SLOTS_PER_CPU=
GOVERNOR_LIGHT_PARSE_SLOTS_PER_CPU=
GOVERNOR_INDEX_SLOTS_PER_PARSE_SLOT=
# Memory assumed resident per in-flight heavy parse, in GiB (default 1.5) —
# sizes the memory gate that holds heavy parsing below its CPU-derived ceiling.
GOVERNOR_HEAVY_PARSE_WORKING_SET_GB=

# LLM row processing threshold
MAX_TABLE_ROWS_FOR_LLM=1000

# Excel table size limits
EXCEL_MAX_TABLE_ROWS_TO_INDEX=20000
EXCEL_HEADER_GENERATION_SAMPLE_SCAN_LIMIT=500

# SAML SP Entity ID (Issuer) — must match the Audience URI in your IdP (e.g. Okta "Audience URI (SP Entity ID)").
# Defaults to FRONTEND_PUBLIC_URL if set, otherwise 'pipeshub'.
SAML_SP_ENTITY_ID=
