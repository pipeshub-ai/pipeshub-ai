# Copy to a gitignored path (never commit the filled file).
# Then:
#   ./bootstrap-first-run.sh --env-file ./bootstrap-first-run.env --token-file "$HOME/.config/pipeshub/token"
#
# Do not paste these values into chat. Do not cat the token file.

PIPESHUB_ORIGIN=http://localhost:3000

PIPESHUB_ACCOUNT_EMAIL=you@example.com
PIPESHUB_ACCOUNT_PASSWORD='ChangeMe1!'
PIPESHUB_ACCOUNT_FULL_NAME='Demo User'
PIPESHUB_ACCOUNT_TYPE=individual
# PIPESHUB_REGISTERED_NAME=   # required when ACCOUNT_TYPE=business

# Provider names match the onboarding form: ollama, openAI, anthropic, gemini, …
PIPESHUB_LLM_PROVIDER=ollama
PIPESHUB_LLM_MODEL=qwen3.5:2b
PIPESHUB_LLM_ENDPOINT=http://host.docker.internal:11434
# PIPESHUB_LLM_API_KEY=       # required except ollama
