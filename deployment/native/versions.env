# Pinned sources of the native bundle. Every tarball is checked against its SHA-256 before it is unpacked.
# PostgreSQL and OpenSSL: the checksums their projects publish next to the tarball. pgvector and pg_textsearch publish none,
# so theirs are of the GitHub tag archive. Node: SHASUMS256.txt of the release. Python: uv checks the
# python-build-standalone download against the checksum built into the pinned uv.
PG_VERSION=18.7
PG_SHA256=441dfae4280cae3e0425e5f876f80559fb0731c140f1aae22b3e5a54d0411bfd
OPENSSL_VERSION=3.5.9
