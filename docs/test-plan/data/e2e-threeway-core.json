 "constraints": [
  {
   "name": "stack_profile",
   "factors": [
    "graph",
    "mongo",
    "kv",
    "broker",
    "deploy"
   ],
   "why": "rows run on one of the seven stack profiles (STACKS), which pairwise-cover the store and deployment factors"
  },
  {
   "name": "standalone_is_infra",
   "factors": [
    "mongo",
    "path"
   ],
   "why": "a standalone MongoDB is what makes the path infrastructure_unavailable, and only it does"
  },
  {
   "name": "engine_needs_durable_agent",
   "factors": [
    "engine",
    "path",
    "mode"
   ],
   "why": "engine runs are durable runs of an engine agent, or of the default chat's Agent mode handing a job to the person's or the org's coding engine (ENGPICK)"
  },
  {
   "name": "engine_needs_broker",
   "factors": [
    "engine",
    "sandbox"
   ],
   "why": "the worker plans no engine without the sandbox broker"
  },
  {
   "name": "engine_wire",
   "factors": [
    "engine",
    "wire"
   ],
   "why": "opencode speaks chat completions, Codex Responses, Claude Code Messages through the model gateway"
  },
  {
   "name": "compiler_is_loop_only",
   "factors": [
    "compiler",
    "engine",
    "path"
   ],
   "why": "the compiler runs only in the durable worker's loop kernel"
  },
  {
   "name": "memory_is_durable",
   "factors": [
    "tool_family",
    "path",
    "mode"
   ],
   "why": "governed memory is absent on the legacy route"
  },
  {
   "name": "memory_needs_a_person",
   "factors": [
    "tool_family",
    "trigger"
   ],
   "why": "a scheduled run is unattended and is granted no memory write scope (P7.3), so it is offered no remember tool"
  },
  {
   "name": "run_code_needs_sandbox",
   "factors": [
    "tool_family",
    "sandbox"
   ],
   "why": "run_code is hidden without SANDBOX_MODE"
  },
  {
   "name": "mode_tool_families",
   "factors": [
    "mode",
    "tool_family"
   ],
   "why": "assistant modes and project chats expose only these tools"
  },
  {
   "name": "scheduled_runs",
   "factors": [
    "trigger",
    "path",
    "mode",
    "action"
   ],
   "why": "schedules fire durable agent runs (a firing the rollout says is legacy is refused) and send a fresh turn"
  },
  {
   "name": "helm_sandbox_modes",
   "factors": [
    "deploy",
    "sandbox"
   ],
   "why": "the chart offers broker mode (and local for values-local), not docker mode"
  },
  {
   "name": "decision_iff_prompt",
   "factors": [
    "decision",
    "path",
    "mode",
    "tool_family",
    "flow_guard",
    "write_policy",
    "engine",
    "child_model"
   ],
   "why": "a row has a user decision exactly when the oracle expects an approval card (see prompt_expected)"
  },
  {
   "name": "conversation_grant_offer",
   "factors": [
    "decision",
    "tool_family",
    "flow_guard",
    "write_policy",
    "engine"
   ],
   "why": "'Allow for this conversation' is offered for a call that names its destination, held by the flow rule or an engine's default alone: an org's own write rule is never granted (QA10-F3)"
  },
  {
   "name": "child_model_needs_delegation",
   "factors": [
    "child_model",
    "mode",
    "engine"
   ],
   "why": "a role's model is read when a run spawns a child run, which only deep mode on a loop run does; an engine's helpers call the run's own model (MA1 \u00a76)"
  }
