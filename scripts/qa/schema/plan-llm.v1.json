{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qa model output",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "qa-plan-llm/v1"
    },
    "add": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "add_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry"
        ],
        "properties": {
          "entry": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "level"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e"
            ]
          },
          "suggested_tc": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
