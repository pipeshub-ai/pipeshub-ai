{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qa generate model output",
  "type": "object",
  "required": [
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarios": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "title",
          "level",
          "steps",
          "expected",
          "data",
          "covers"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "level": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
