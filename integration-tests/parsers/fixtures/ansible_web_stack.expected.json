      "source_type": null,
      "data": "# [0].tasks | scope: if deploy_web\n    {% if enable_ssl %}\n    - name: Install TLS certificate\n      copy:\n        dest: /etc/ssl/{{ app_name }}/fullchain.pem\n        src: {{ ssl_cert }}\n        owner: root\n        mode: \"0644\"\n      notify: reload nginx\n\n    - name: Install TLS private key\n      copy:\n        dest: /etc/ssl/{{ app_name }}/privkey.pem\n        src: {{ ssl_key }}\n        owner: root\n        mode: \"0600\"\n      notify: reload nginx\n    {% endif %}\n\n    - name: Render nginx site\n      template:\n        src: nginx.conf.j2\n        dest: /etc/nginx/sites-available/{{ app_name }}\n      notify: reload nginx\n\n    - name: Enable nginx site\n      file:\n        src: /etc/nginx/sites-available/{{ app_name }}\n        dest: /etc/nginx/sites-enabled/{{ app_name }}\n        state: link\n      notify: reload nginx",
