      "data": "{% if deploy_workers %}\n- name: Deploy {{ app_name }} workers\n  hosts: {{ worker_hosts | default('workers') }}\n  become: true\n  vars:\n    worker_user: {{ app_user | default('www-data') }}\n    worker_root: /opt/{{ app_name }}-worker\n  tasks:\n    - name: Install worker packages\n      apt:\n        name:\n          - python3\n          - python3-venv\n          - redis-tools\n        state: present\n\n    - name: Create worker directories\n      file:\n        path: {{ item }}\n        state: directory\n        owner: {{ worker_user }}\n        mode: \"0755\"\n      loop:\n        - {{ worker_root }}\n        - {{ worker_root }}/shared\n        - /var/log/{{ app_name }}-worker\n\n    - name: Write worker environment\n      copy:\n        dest: {{ worker_root }}/shared/.env\n        owner: {{ worker_user }}\n        mode: \"0600\"\n        content: |\n          APP_NAME={{ app_name }}\n          APP_ROLE=worker\n          REDIS_URL={{ redis_url }}\n          DATABASE_URL={{ database_url }}\n          WORKER_CONCURRENCY={{ worker_concurrency | default(4) }}\n          WORKER_QUEUES={{ worker_queues | default('default,mail,index') }}\n      notify: restart {{ app_name }}-worker\n\n    {% for queue in worker_queues | default(['default', 'mail', 'index']) %}\n    - name: Enable {{ queue }} worker unit\n      systemd:\n        name: {{ app_name }}-{{ queue }}\n        enabled: true\n        state: started\n        daemon_reload: true\n    {% endfor %}\n{% endif %}",
