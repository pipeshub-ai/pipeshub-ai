      "data": "# application.env\n    - name: APP_NAME\n      value: {{ app_name }}\n    - name: APP_ENV\n      value: {{ app_env }}\n    - name: LOG_LEVEL\n      value: {{ log_level | default('info') }}\n    - name: PORT\n      value: {{ app_port | default(8000) }}\n    - name: NODEJS_PORT\n      value: {{ backend_port | default(3000) }}\n    - name: QUERY_PORT\n      value: {{ query_port | default(8000) }}\n    - name: CONNECTOR_PORT\n      value: {{ connector_port | default(8088) }}\n    - name: INDEXING_PORT\n      value: {{ indexing_port | default(8091) }}\n    - name: REDIS_URL\n      value: {{ redis_url }}\n    - name: REDIS_CACHE_TTL\n      value: {{ redis_cache_ttl | default(300) }}\n    - name: DATABASE_URL\n      value: {{ database_url }}\n    - name: DATABASE_POOL\n      value: {{ database_pool | default(10) }}\n    - name: DATABASE_TIMEOUT\n      value: {{ database_timeout | default(30) }}\n    - name: SMTP_HOST\n      value: {{ smtp_host }}\n    - name: SMTP_PORT\n      value: {{ smtp_port | default(587) }}\n    - name: SMTP_USER\n      value: {{ smtp_user }}\n    - name: SMTP_FROM\n      value: {{ smtp_from }}\n    - name: S3_BUCKET\n      value: {{ s3_bucket }}\n    - name: S3_REGION\n      value: {{ s3_region | default('us-east-1') }}\n    - name: S3_PREFIX\n      value: {{ s3_prefix | default(app_name) }}",
