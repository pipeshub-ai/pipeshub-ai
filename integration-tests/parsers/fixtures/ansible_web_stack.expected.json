      "source_id": null,
      "source_name": null,
      "source_type": null,
      "data": "# [0].tasks | scope: if deploy_web\n    - name: Install runtime packages\n      apt:\n        name:\n          - nginx\n          - python3\n          - python3-venv\n          - redis-server\n        state: present\n        update_cache: true\n\n    - name: Create application directories\n      file:\n        path: {{ item }}\n        state: directory\n        owner: {{ app_user }}\n        mode: \"0755\"\n      loop:\n        - {{ app_root }}\n        - {{ app_root }}/releases\n        - {{ app_root }}/shared\n        - {{ log_dir }}\n\n    - name: Write application environment\n      copy:\n        dest: {{ app_root }}/shared/.env\n        owner: {{ app_user }}\n        mode: \"0600\"\n        content: |\n          APP_NAME={{ app_name }}\n          APP_ENV={{ app_env }}\n          LOG_LEVEL={{ log_level | default('info') }}\n          REDIS_URL={{ redis_url }}\n          DATABASE_URL={{ database_url }}\n      notify: restart {{ app_name }}",
      "links": null,
