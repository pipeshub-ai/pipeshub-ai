# Copy to .env.local and fill in. Used when .env has PIPESHUB_TEST_ENV=local
# Do not commit .env.local — it contains secrets.

# Local backend
PIPESHUB_BASE_URL=http://localhost:3000

# Leave empty to use PIPESHUB_TEST_USER_* (tests will create OAuth app); or set pre-created app creds
CLIENT_ID=
CLIENT_SECRET=

# Org admin — required when CLIENT_ID/CLIENT_SECRET are empty
PIPESHUB_TEST_USER_EMAIL=
PIPESHUB_TEST_USER_PASSWORD=

# Existing user id in the same org. Share/unshare tests skip when empty.
PIPESHUB_TEST_SHARE_TARGET_USER_ID=

# TEST_MONGO_URI=
# Must match the Node app's MONGO_DB_NAME
# TEST_MONGO_DB_NAME=

TEST_GRAPH_DB_TYPE=neo4j   # arango / neo4j

TEST_NEO4J_URI=bolt://localhost:7687
TEST_NEO4J_USERNAME=neo4j
TEST_NEO4J_PASSWORD=
TEST_NEO4J_DATABASE=neo4j

# TEST_ARANGO_URL=http://localhost:8529
# TEST_ARANGO_USERNAME=root
# TEST_ARANGO_PASSWORD=your_password
# TEST_ARANGO_DB_NAME=es

# Message broker: "kafka" or "redis" (must match the backend's MESSAGE_BROKER)
MESSAGE_BROKER=redis

# Kafka (only needed when MESSAGE_BROKER=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Redis (used for both KV store and messaging when MESSAGE_BROKER=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage credentials — same as .env.example; only for connectors you run
S3_ACCESS_KEY=
S3_SECRET_KEY=
# A second pre-provisioned bucket the S3 key can write; without it TC-ACCESS-REVOKE-001 skips.
S3_SECOND_TEST_BUCKET=
GCS_SERVICE_ACCOUNT_JSON=
AZURE_BLOB_CONNECTION_STRING=
AZURE_FILES_CONNECTION_STRING=

# Jira Cloud (API token auth)
JIRA_TEST_BASE_URL=
JIRA_TEST_EMAIL=
JIRA_TEST_API_TOKEN=

CONFLUENCE_TEST_BASE_URL=
CONFLUENCE_TEST_EMAIL=
CONFLUENCE_TEST_API_TOKEN=
CONFLUENCE_TEST_SPACE_KEY=

LINEAR_TEST_API_TOKEN=
LINEAR_TEST_TEAM_IDS=

GH_TEAMS_TEST_TOKEN=
GH_TEAMS_TEST_ORG=
GH_TEAMS_TEST_PRIMARY_REPO=
GH_TEAMS_TEST_PUBLIC_REPO=
GH_TEAMS_TEST_MUTATION_REPO=
# Optional: path of a >5 MB file in the primary repo; unset skips that assertion.
GH_TEAMS_TEST_OVERSIZED_PATH=

# --- GitLab connector -------------------------------------------------------
GITLAB_TEST_TOKEN=
GITLAB_TEST_INSTANCE_URL=
GITLAB_TEST_GROUP=
GITLAB_TEST_SUBGROUP=
GITLAB_TEST_PRIMARY_PROJECT=
GITLAB_TEST_MUTATION_PROJECT=

NOTION_TEST_API_TOKEN=
# Optional overrides, only needed when more than one root is shared with the integration.
NOTION_TEST_ROOT_PAGE_ID=
NOTION_TEST_ROOT_DATABASE_ID=
# Against the Notion simulator instead (connectors/notion_sim.env sets these): the pinned fixture tree's
# manifest, the simulator's reset route, the API base the test process uses and the one the connector uses.
NOTION_TEST_SEED_MANIFEST=
NOTION_TEST_RESET_URL=
NOTION_API_BASE_URL=
NOTION_CONNECTOR_BASE_URL=

# Google Drive Workspace (service account + domain-wide delegation)
# SA JSON must be the raw file contents (single-line or quoted).
# TEST_USER_EMAIL is impersonated for Drive fixtures; conftest creates+activates that
# email as a Pipeshub org user if missing (Drive Workspace syncs Workspace ∩ active users).
# SECOND_USER_EMAIL is the inactive→active share partner for Shared-with-Me ITs
# (DWD impersonation; share tests skip when empty).
# DWD for the SA client_id must include https://www.googleapis.com/auth/drive.
# Shared Drive folder-filter ITs create/delete two temporary Shared Drives under the
# test user — that user must be allowed to create Shared Drives (Workspace admin).
GOOGLE_DRIVE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_DRIVE_WORKSPACE_TEST_USER_EMAIL=
GOOGLE_DRIVE_WORKSPACE_SECOND_USER_EMAIL=
# Optional: a third member who owns a Shared Drive the test user is not in (personal shortcut IT).
GOOGLE_DRIVE_WORKSPACE_THIRD_USER_EMAIL=
# Optional: an address outside the Workspace, shared with in the lifecycle ITs (Person node + signup).
GOOGLE_DRIVE_USER_OUTSIDE_WORKSPACE=

# Google Drive personal (OAuth). Refresh token goes in .env.refresh_tokens as
# GOOGLE_DRIVE_REFRESH_TOKEN.
# writes encrypted credentials into Redis/etcd.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_TEST_USER_EMAIL=
SECRET_KEY=

# Storage suite: /api/v1/document is service-to-service only. Set this to the
# deployment's SCOPED_JWT_SECRET so the tests can mint storage tokens. This is
# the test-only value the integration compose files start the stack with; the
# stack reads it only on its first boot, so a stack started with another value
# (or before this was pinned) needs that value here, or `down -v` and a restart.
SCOPED_JWT_SECRET=pipeshub-integration-scoped-jwt-secret-test-only

# Outlook (team / Microsoft 365, app-only client-credentials).
# The Azure AD app registration needs these Application permissions with admin consent:
#   Mail.ReadWrite, Mail.Send, User.Read.All, Group.Read.All, Group.ReadWrite.All,
#   Directory.ReadWrite.All (the suite adds/removes a group member, creates two throwaway
#   users and creates/deletes one throwaway M365 group per run), User.ReadWrite.All
#   (it disables and re-enables one throwaway user). Deleting the throwaway users also
#   needs a directory role on the app, such as User Administrator; without it the
#   user-delete case skips and the users are only disabled and renamed.
# Pre-provision two licensed mailboxes and one M365 group with a mailbox. The suite seeds
# everything else per run (all named PHIT-<run>) and deletes it at teardown.
OUTLOOK_TEST_TENANT_ID=
OUTLOOK_TEST_CLIENT_ID=
OUTLOOK_TEST_CLIENT_SECRET=
# Two AAD object ids (or UPNs), comma-separated: primary mailbox first, secondary second.
OUTLOOK_TEST_USER_IDS=
# The M365 group's object id.
OUTLOOK_TEST_GROUP_ID=
# 1 = also seed a mail with an attachment over the 25 MiB indexing cap (uploads and streams ~25 MB).
# OUTLOOK_TEST_LARGE_ATTACHMENT=1


# AI models — required for the indexing e2e pipeline tests. Without an LLM and
# cloud embedding configured on the backend, records will never reach
# indexingStatus=COMPLETED (embedding falls back to the slow local CPU model).
# The session fixture POSTs an OpenAI LLM and embedding to
# /api/v1/configurationManager/ai-models/providers at session start and DELETEs
# them at session end.
TEST_OPENAI_API_KEY=

# Azure OpenAI is what CI runs on. The helper prefers it over OpenAI whenever
# these are set, so filling them in here uses it locally too.
TEST_AI_MODEL_PROVIDER=
TEST_AZURE_OPENAI_API_KEY=
TEST_AZURE_OPENAI_ENDPOINT=
# The deployment's name in your Azure resource, and the model behind it. They
# are often the same string, but both are needed.
TEST_AZURE_OPENAI_DEPLOYMENT_NAME=
TEST_AZURE_OPENAI_MODEL=
# Leave these blank only if the LLM deployment also serves embeddings.
# Unset, they fall back to the LLM deployment, which sends embedding requests
# to a chat model.
TEST_AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
TEST_AZURE_OPENAI_EMBEDDING_MODEL=
# Optional override (default: gpt-5.4-nano for indexing; gpt-4o-mini in provider ITs)
TEST_OPENAI_LLM_MODEL=
# Optional override (default: text-embedding-3-small)
TEST_OPENAI_EMBEDDING_MODEL=

# Provider integration tests (integration_test_ai_model_providers.py) — skip when unset
TEST_GEMINI_API_KEY=
TEST_GEMINI_LLM_MODEL=
TEST_GROQ_API_KEY=
TEST_GROQ_LLM_MODEL=
# Optional non-admin user for admin-gate negative tests
# PIPESHUB_TEST_NON_ADMIN_EMAIL=
# PIPESHUB_TEST_NON_ADMIN_PASSWORD=

