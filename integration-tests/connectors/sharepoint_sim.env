# The sharepoint_sim suite against the sharepoint-sim service of
# deployment/docker-compose/docker-compose.integration.sharepoint-sim.yml. Unlike the Atlassian suites
# there is no content pack: each test loads its own tenant through the simulator's control API, which the
# test process reaches on the published port. The connector reaches the simulator under Microsoft's host
# names; nothing here is a real credential (the tests make the app's certificate per run).
SHAREPOINT_SIM_URL=http://localhost:8107
SHAREPOINT_SIM_SYNC_TIMEOUT_SEC=600
SHAREPOINT_SIM_SETTLE_TIMEOUT_SEC=90
