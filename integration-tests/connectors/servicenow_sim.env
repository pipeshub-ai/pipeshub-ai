# The servicenow_sim suite against the servicenow-sim service of
# deployment/docker-compose/docker-compose.integration.servicenow-sim.yml. There is no content pack: the
# simulator generates its instance, and each test starts from it again (/_sim/reset). The test process reaches
# the control API on the published port; the connector reaches the simulator by its service name and signs in
# with basic auth (the simulator accepts any password for its users).
SERVICENOW_SIM_URL=http://localhost:8109
SERVICENOW_SIM_CONNECTOR_URL=http://servicenow-sim
SERVICENOW_SIM_SYNC_TIMEOUT_SEC=600
SERVICENOW_SIM_SETTLE_TIMEOUT_SEC=120
