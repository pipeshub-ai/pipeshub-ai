# Confluence and Jira suites against the confluence-sim and jira-sim compose services
# (atlassian-sim profile). Every fixture value below belongs to the world those services
# serve: the lumenfold@1 content pack (CONNSIM_PACK_URI / CONNSIM_PACK_SHA256 in the
# workflow) at the simulator commit the workflow builds (CONNSIM_REF), with the build
# time pinned in the compose file. Change any of those and re-pick these values.
#
# The test process reaches the simulators on their published ports; the connector,
# inside the compose network, by alias (*_CONNECTOR_BASE_URL). Credentials are the
# simulator's sync account; it accepts any token.
CONFLUENCE_TEST_BASE_URL=http://localhost:8101/wiki/api/v2
CONFLUENCE_CONNECTOR_BASE_URL=http://confluence-sim.atlassian.net
CONFLUENCE_TEST_EMAIL=svc-pipeshub-sync@lumenfold.example.com
CONFLUENCE_TEST_API_TOKEN=connsim-token
# The pack's smallest space (76 pages, 4 folders, 2 blog posts, 27 view restrictions):
# TC-CF-005 runs, and the matrix's own pages are not stuck behind a long indexing queue.
CONFLUENCE_TEST_SPACE_KEY=ARCHIVE
CONFLUENCE_TEST_SETTLE_WAIT_SEC=120
CONFLUENCE_MATRIX_VISIBLE_TIMEOUT_SEC=60

JIRA_TEST_BASE_URL=http://localhost:8102
JIRA_CONNECTOR_BASE_URL=http://jira-sim.internal
JIRA_TEST_EMAIL=svc-pipeshub-sync@lumenfold.example.com
JIRA_TEST_API_TOKEN=connsim-token
# QE (399 issues): BROWSE granted to licensed users, lead email visible. FINOPS (320):
# group BROWSE.
JIRA_TEST_PROJECT_KEYS=QE,FINOPS
JIRA_REFERENCE_ISSUE_KEY=QE-247
JIRA_LINK_SOURCE_ISSUE_KEY=QE-138
JIRA_BLOCKS_ISSUE_KEY=QE-300
JIRA_BLOCKS_SNAPSHOT=jira_issue_blocks.pack.expected.json
JIRA_USERS_GROUP_NAME=jira-software-users
# 200 QE issues created on or before, 199 after; no issue within a minute of it.
JIRA_FILTER_DATE_CUT_MS=1748880720000
# Sub-task QE-241 under Task QE-210 under Epic QE-19; the cut is the child's creation minute.
JIRA_PH_CHILD_KEY=QE-241
JIRA_PH_CREATED_CUT_MS=1774087920000
JIRA_PH_ANCESTOR_KEYS=QE-210,QE-19
# The pack has no Jira attachments, so TC-JIRA-ATTACH-001 skips.
JIRA_ATTACHMENT_ISSUE_KEY=
