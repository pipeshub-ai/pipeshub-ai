# Confluence and Jira suites against the confluence-sim and jira-sim compose services
# (atlassian-sim profile). Every fixture value below belongs to the world those services
# pin (seed 12, 1000 pages, 1000 issues, fixed build time) at the simulator commit the
# workflow builds (CONNSIM_REF). Change any of those and re-pick these values.
#
# The test process reaches the simulators on their published ports; the connector,
# inside the compose network, by alias (*_CONNECTOR_BASE_URL). Credentials are the
# simulator's sync account; it accepts any token.
CONFLUENCE_TEST_BASE_URL=http://localhost:8101/wiki/api/v2
CONFLUENCE_CONNECTOR_BASE_URL=http://confluence-sim.atlassian.net
CONFLUENCE_TEST_EMAIL=svc-pipeshub-sync@simcorp.example.com
CONFLUENCE_TEST_API_TOKEN=connsim-token
# A small space (22 pages) with a folder and a blog post: TC-CF-005 runs, and the
# matrix's own pages are not stuck behind a long indexing queue.
CONFLUENCE_TEST_SPACE_KEY=IDEN
CONFLUENCE_TEST_SETTLE_WAIT_SEC=120
CONFLUENCE_MATRIX_VISIBLE_TIMEOUT_SEC=60

JIRA_TEST_BASE_URL=http://localhost:8102
JIRA_CONNECTOR_BASE_URL=http://jira-sim.internal
JIRA_TEST_EMAIL=svc-pipeshub-sync@simcorp.example.com
JIRA_TEST_API_TOKEN=connsim-token
# CASC: BROWSE granted to licensed users. FALC: group BROWSE. Both leads have visible emails.
JIRA_TEST_PROJECT_KEYS=CASC,FALC
JIRA_REFERENCE_ISSUE_KEY=CASC-95
JIRA_LINK_SOURCE_ISSUE_KEY=CASC-96
JIRA_BLOCKS_ISSUE_KEY=CASC-91
JIRA_BLOCKS_SNAPSHOT=jira_issue_blocks.sim.expected.json
JIRA_USERS_GROUP_NAME=jira-software-users
# 49 CASC issues created on or before, 47 after; no issue within a minute of it.
JIRA_FILTER_DATE_CUT_MS=1684430940000
# Sub-task CASC-90 under Bug CASC-74 under Epic CASC-55; the cut is the child's creation minute.
JIRA_PH_CHILD_KEY=CASC-90
JIRA_PH_CREATED_CUT_MS=1755493440000
JIRA_PH_ANCESTOR_KEYS=CASC-74,CASC-55
JIRA_ATTACHMENT_ISSUE_KEY=CASC-93
