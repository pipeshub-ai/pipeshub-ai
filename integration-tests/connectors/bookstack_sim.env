# The bookstack_sim suite against the bookstack-sim service of
# deployment/docker-compose/docker-compose.integration.bookstack-sim.yml. There is no content pack: each test
# loads its own instance through the simulator's control API, which the test process reaches on the published
# port. The connector reaches the simulator by its service name; the token is the suite's fixed test value.
BOOKSTACK_SIM_URL=http://localhost:8110
BOOKSTACK_SIM_CONNECTOR_URL=http://bookstack-sim
BOOKSTACK_SIM_SYNC_TIMEOUT_SEC=600
BOOKSTACK_SIM_SETTLE_TIMEOUT_SEC=90
