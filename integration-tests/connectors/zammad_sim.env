# The zammad_sim suite against the zammad-sim service of
# deployment/docker-compose/docker-compose.integration.zammad-sim.yml. There is no content pack: each test loads its
# own installation through the simulator's control API, which the test process reaches on the published port. The
# connector reaches the simulator by its service name; the tokens are the suite's fixed test values
# (connectors/zammad/sim_instances.py).
ZAMMAD_SIM_URL=http://localhost:8112
ZAMMAD_SIM_CONNECTOR_URL=http://zammad-sim
ZAMMAD_SIM_SYNC_TIMEOUT_SEC=600
ZAMMAD_SIM_SETTLE_TIMEOUT_SEC=90
