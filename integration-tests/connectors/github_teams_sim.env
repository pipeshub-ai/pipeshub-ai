# The github_teams_sim suite against the github-sim service of deployment/docker-compose/docker-compose.integration.github-teams-sim.yml.
# There is no content pack: each test loads its own world through the simulator's control API, which the test process
# reaches on the published port. The connector reaches the simulator as api.github.com and github.com through the
# overlay's TLS front; nothing here is a real credential. The suite also needs the docker CLI, to check where those names
# resolve inside the PipesHub container (set GITHUB_SIM_APP_CONTAINER when several stacks run on the host).
GITHUB_SIM_URL=http://localhost:8116
GITHUB_SIM_SYNC_TIMEOUT_SEC=600
GITHUB_SIM_SETTLE_TIMEOUT_SEC=60
