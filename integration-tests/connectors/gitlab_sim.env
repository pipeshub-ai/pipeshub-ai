# The gitlab_sim suite against the gitlab-sim service of
# deployment/docker-compose/docker-compose.integration.gitlab-sim.yml. There is no content pack: each test loads its
# own instance through the simulator's control API, which the test process reaches on the published port. The
# connector reaches the simulator by its service name; the tokens are the suite's fixed test values
# (connectors/gitlab/sim_instances.py).
GITLAB_SIM_URL=http://localhost:8113
GITLAB_SIM_CONNECTOR_URL=http://gitlab-sim
GITLAB_SIM_SYNC_TIMEOUT_SEC=600
GITLAB_SIM_SETTLE_TIMEOUT_SEC=90
