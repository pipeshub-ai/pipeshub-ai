# The zendesk_sim suite against the zendesk-sim service of deployment/docker-compose/docker-compose.integration.zendesk-sim.yml.
# There is no content pack: each test loads its own account through the simulator's control API, which the test process
# reaches on the published port. The connector reaches the simulator as pipeshubsim.zendesk.com and
# pipeshubsim.zdusercontent.com through the overlay's TLS front; nothing here is a real credential. The suite also needs
# the docker CLI, to check where those names resolve inside the PipesHub container (set ZENDESK_SIM_APP_CONTAINER when
# several stacks run on the host).
ZENDESK_SIM_URL=http://localhost:8115
ZENDESK_SIM_SYNC_TIMEOUT_SEC=600
ZENDESK_SIM_SETTLE_TIMEOUT_SEC=90
