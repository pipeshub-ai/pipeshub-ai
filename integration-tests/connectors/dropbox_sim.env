# Dropbox suites against the dropbox-sim compose service (dropbox-sim profile). The test process reaches the
# simulator on its published port; the Dropbox connectors, inside the compose network, by alias through
# DROPBOX_API_BASE_URL (passed to the pipeshub service by the integration compose files). The OAuth app and the
# refresh token are the simulator's own: nothing here works against the real Dropbox.
DROPBOX_SIM_URL=http://localhost:8109
DROPBOX_API_BASE_URL=http://dropbox-sim.internal
DROPBOX_SIM_CLIENT_ID=dbx-sim-app-key
DROPBOX_SIM_CLIENT_SECRET=dbx-sim-app-secret
DROPBOX_SIM_REFRESH_TOKEN=dbx-sim-refresh-token
