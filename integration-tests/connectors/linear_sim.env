# The linear_sim suite against the linear-sim service of deployment/docker-compose/docker-compose.integration.linear-sim.yml.
# There is no content pack: each test loads its own workspace through the simulator's control API, which the test process
# reaches on the published port. The connector reaches the simulator as api.linear.app, linear.app and uploads.linear.app
# through the overlay's TLS front; nothing here is a real credential. The suite also needs the docker CLI, to check where
# those names resolve inside the PipesHub container (set LINEAR_SIM_APP_CONTAINER when several stacks run on the host).
LINEAR_SIM_URL=http://localhost:8114
LINEAR_SIM_SYNC_TIMEOUT_SEC=600
LINEAR_SIM_SETTLE_TIMEOUT_SEC=60
