# The Notion suite against the notion-sim compose service (notion-sim profile). The service serves the
# Notion part of the content pack the workflow downloads (CONNSIM_PACK_URI / CONNSIM_PACK_SHA256) at the
# simulator commit it builds (CONNSIM_REF), seed and build time pinned in the compose file. The pack holds
# the suite's fixture tree, built once by its own seeder; fixtures/notion_sim_seed.json names every id in
# it. Change the pack or the seeder and rebuild both (the simulator's harness/notion_it_fixtures.py).
#
# The test process reaches the simulator on its published port; the connector, inside the compose
# network, by alias (NOTION_CONNECTOR_BASE_URL becomes the app container's NOTION_API_BASE_URL). The
# token is the simulator's integration that sees only the fixture tree.
NOTION_TEST_API_TOKEN=connsim-it-token
NOTION_API_BASE_URL=http://localhost:8103/v1
NOTION_CONNECTOR_BASE_URL=http://notion-sim.internal/v1
NOTION_TEST_SEED_MANIFEST=fixtures/notion_sim_seed.json
NOTION_TEST_RESET_URL=http://localhost:8103/_sim/reset
