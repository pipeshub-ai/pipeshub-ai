# The jira_cloud_sim suite against the jira-cloud-sim service of
# deployment/docker-compose/docker-compose.integration.jira-cloud-sim.yml. The simulator generates its world (a small,
# seeded Jira); each test resets it (/_sim/reset) and changes it through the vendor's write API and the control API on
# the published port. The connector reaches the simulator by its network alias.
JIRA_CLOUD_SIM_URL=http://localhost:8102
JIRA_CLOUD_SIM_CONNECTOR_URL=http://jira-cloud-sim.internal
JIRA_CLOUD_SIM_SYNC_TIMEOUT_SEC=600
JIRA_CLOUD_SIM_SETTLE_TIMEOUT_SEC=90
# A PipesHub account removed in a test is restored through the invite route, which needs the mail server the stack runs.
SMTP_HOST=mailpit
SMTP_PORT=1025
