# Salesforce suite against the salesforce-sim service (compose file
# docker-compose.integration.salesforce-sim.yml). The test process reaches the simulator on
# its published port; the connector, inside the compose network, by alias. The simulator
# starts empty: the suite loads its own org (connectors/salesforce/scenario.py), so there is
# no content pack and no secret.
SALESFORCE_SIM_URL=http://localhost:8118
SALESFORCE_CONNECTOR_BASE_URL=http://salesforce-sim.internal
