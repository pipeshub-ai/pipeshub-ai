# The jira_dc_sim suite against the jira-dc-sim service of
# deployment/docker-compose/docker-compose.integration.jira-dc-sim.yml. The simulator generates its world (a small, seeded
# Jira); each test resets it (/_sim/reset) and changes it through the control API on the published port. The connector
# reaches the simulator by its network alias; the sign-in values are the suite's fixed test values
# (connectors/jira_data_center/sim_world.py).
JIRA_DC_SIM_URL=http://localhost:8111
JIRA_DC_SIM_CONNECTOR_URL=http://jira-dc-sim.internal
JIRA_DC_SIM_SYNC_TIMEOUT_SEC=600
JIRA_DC_SIM_SETTLE_TIMEOUT_SEC=90
# A PipesHub account removed in a test (TC-JDSIM-ACL-013) is restored through the invite route, which needs the mail server
# the stack runs (the compose service "mailpit"), as the product reaches it from inside its container.
SMTP_HOST=mailpit
SMTP_PORT=1025
