# The drupal_wiki_sim suite against the drupal-wiki-sim service of
# deployment/docker-compose/docker-compose.integration.drupal-wiki-sim.yml. There is no content pack: the simulator
# serves its seed wiki and each test changes it through the control API, which the test process reaches on the
# published port. The connector reaches the simulator by its alias; the token is the seed wiki's.
DRUPAL_WIKI_SIM_URL=http://localhost:8108
DRUPAL_WIKI_SIM_CONNECTOR_URL=http://drupal-wiki-sim.internal
DRUPAL_WIKI_SIM_SYNC_TIMEOUT_SEC=600
DRUPAL_WIKI_SIM_SETTLE_TIMEOUT_SEC=60
