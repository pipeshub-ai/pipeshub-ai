# Gmail suites against the gmail-sim compose service (gmail-sim profile). The test process reaches the
# simulator on its published port; the Gmail connectors, inside the compose network, by alias through
# GMAIL_GOOGLE_API_BASE_URL (passed to the pipeshub service by the integration compose files).
#
# Every value below belongs to the simulated Google tenant the suites load, so none is a secret and none
# reaches Google. The Workspace service account's key is generated by the test process at start-up
# (connectors/gmail/gmail_env.py) and only its public half is given to the simulator.
GMAIL_SIM_URL=http://localhost:8106
GMAIL_GOOGLE_API_BASE_URL=http://gmail-sim.internal

GMAIL_SIM_WORKSPACE_ADMIN_EMAIL=gmail-it-admin@mailsim.example.com
GMAIL_SIM_WORKSPACE_TEST_USER_EMAIL=gmail-it-owner@mailsim.example.com
GMAIL_SIM_WORKSPACE_SECOND_USER_EMAIL=gmail-it-second@mailsim.example.com

GMAIL_SIM_OAUTH_CLIENT_ID=connsim-gmail-it.apps.googleusercontent.com
GMAIL_SIM_OAUTH_CLIENT_SECRET=connsim-gmail-it-client-secret
GMAIL_SIM_REFRESH_TOKEN=1//connsim-gmail-it-refresh-token
GMAIL_SIM_PERSONAL_USER_EMAIL=gmail-it-personal@mailsim.example.com
