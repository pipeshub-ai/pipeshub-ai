# Gmail suites against the gmail-sim compose service (gmail-sim profile). The test process reaches the
# simulator on its published port; the Gmail connectors, inside the compose network, by alias through
# GMAIL_GOOGLE_API_BASE_URL (passed to the pipeshub service by the integration compose files). Credentials are
# the Google Drive suites' own (connectors/gmail/DESIGN.md, section 3).
GMAIL_SIM_URL=http://localhost:8106
GMAIL_GOOGLE_API_BASE_URL=http://gmail-sim.internal
