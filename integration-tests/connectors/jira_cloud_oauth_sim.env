# The OAuth suites (jira_cloud_sim_oauth_test.py, jira_cloud_sim_personal_test.py) against the jira-cloud-oauth-sim service
# of deployment/docker-compose/docker-compose.integration.jira-cloud-oauth-sim.yml. The connector reaches the simulator as
# auth.atlassian.com and api.atlassian.com through the overlay's TLS front; this process drives its control API on the
# published port. The suite needs the docker CLI, to check where those names resolve inside the PipesHub container (set
# JIRA_CLOUD_OAUTH_SIM_APP_CONTAINER when several stacks run on the host). Nothing here is a real credential.
JIRA_CLOUD_OAUTH_SIM_URL=http://localhost:8130
JIRA_CLOUD_SIM_SYNC_TIMEOUT_SEC=600
JIRA_CLOUD_SIM_SETTLE_TIMEOUT_SEC=90
SMTP_HOST=mailpit
SMTP_PORT=1025
