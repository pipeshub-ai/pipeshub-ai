# The zoom_sim suite against the zoom-sim service of deployment/docker-compose/docker-compose.integration.zoom-sim.yml.
# There is no content pack: each test loads its own account through the simulator's control API, which the test
# process reaches on the published port. The connector reaches the simulator as api.zoom.us and zoom.us through the
# overlay's TLS front; nothing here is a real credential. The suite also needs the docker CLI, to check where those
# names resolve inside the PipesHub container (set ZOOM_SIM_APP_CONTAINER when several stacks run on the host).
ZOOM_SIM_URL=http://localhost:8117
ZOOM_SIM_SYNC_TIMEOUT_SEC=600
ZOOM_SIM_SETTLE_TIMEOUT_SEC=90
