# Copy to .env.prod and fill in. Used when .env has PIPESHUB_TEST_ENV=prod
# Do not commit .env.prod — it contains secrets.

# Remote test environment (test.pipeshub.com)
PIPESHUB_BASE_URL=https://test.pipeshub.com

# Prod auth: OAuth2 client_credentials (required for remote runs)
CLIENT_ID=
CLIENT_SECRET=

# Existing user id in the same org. Share/unshare tests skip when empty.
PIPESHUB_TEST_SHARE_TARGET_USER_ID=

# Neo4j Aura (driver uses TEST_NEO4J_* only)
TEST_NEO4J_URI=
TEST_NEO4J_USERNAME=
TEST_NEO4J_PASSWORD=
TEST_NEO4J_DATABASE=neo4j

# Storage credentials — only for connectors you run
S3_ACCESS_KEY=
S3_SECRET_KEY=
# A second pre-provisioned bucket the S3 key can write; without it TC-ACCESS-REVOKE-001 skips.
S3_SECOND_TEST_BUCKET=
GCS_SERVICE_ACCOUNT_JSON=
AZURE_BLOB_CONNECTION_STRING=
AZURE_FILES_CONNECTION_STRING=

# AI models — required for the indexing e2e pipeline tests. The session fixture
# POSTs an OpenAI LLM and cloud embedding to
# /api/v1/configurationManager/ai-models/providers at session start and DELETEs
# them at session end.
TEST_OPENAI_API_KEY=

# Azure OpenAI is what CI runs on. The helper prefers it over OpenAI whenever
# these are set, so filling them in here uses it locally too.
TEST_AI_MODEL_PROVIDER=
TEST_AZURE_OPENAI_API_KEY=
TEST_AZURE_OPENAI_ENDPOINT=
# The deployment's name in your Azure resource, and the model behind it. They
# are often the same string, but both are needed.
TEST_AZURE_OPENAI_DEPLOYMENT_NAME=
TEST_AZURE_OPENAI_MODEL=
# Leave these blank only if the LLM deployment also serves embeddings.
# Unset, they fall back to the LLM deployment, which sends embedding requests
# to a chat model.
TEST_AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
TEST_AZURE_OPENAI_EMBEDDING_MODEL=
# Optional override (default: gpt-5.4-nano)
TEST_OPENAI_LLM_MODEL=
# Optional override (default: text-embedding-3-small)
TEST_OPENAI_EMBEDDING_MODEL=

# Provider integration tests (integration_test_ai_model_providers.py) — skip when unset
TEST_GEMINI_API_KEY=
TEST_GEMINI_LLM_MODEL=
TEST_GROQ_API_KEY=
TEST_GROQ_LLM_MODEL=
# PIPESHUB_TEST_NON_ADMIN_EMAIL=
# PIPESHUB_TEST_NON_ADMIN_PASSWORD=

# Jira Cloud (API token auth)
JIRA_TEST_BASE_URL=
JIRA_TEST_EMAIL=
JIRA_TEST_API_TOKEN=
CONFLUENCE_TEST_BASE_URL=
CONFLUENCE_TEST_EMAIL=
CONFLUENCE_TEST_API_TOKEN=
CONFLUENCE_TEST_SPACE_KEY=
LINEAR_TEST_API_TOKEN=
LINEAR_TEST_TEAM_IDS=

NOTION_TEST_API_TOKEN=
NOTION_TEST_ROOT_PAGE_ID=
NOTION_TEST_ROOT_DATABASE_ID=
# Against the Notion simulator instead (connectors/notion_sim.env sets these): the pinned fixture tree's
# manifest, the simulator's reset route, the API base the test process uses and the one the connector uses.
NOTION_TEST_SEED_MANIFEST=
NOTION_TEST_RESET_URL=
NOTION_API_BASE_URL=
NOTION_CONNECTOR_BASE_URL=

# Google Drive Workspace (service account + domain-wide delegation)
# Shared Drive folder-filter ITs create/delete two temporary Shared Drives; the
# test user must be allowed to create Shared Drives in Workspace admin.
# SECOND_USER_EMAIL is the inactive→active share partner for Shared-with-Me ITs
# (share tests skip when empty).
GOOGLE_DRIVE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_DRIVE_WORKSPACE_TEST_USER_EMAIL=
GOOGLE_DRIVE_WORKSPACE_SECOND_USER_EMAIL=
# Optional: a third member who owns a Shared Drive the test user is not in (personal shortcut IT).
GOOGLE_DRIVE_WORKSPACE_THIRD_USER_EMAIL=
# Optional: an address outside the Workspace, shared with in the lifecycle ITs (Person node + signup).
GOOGLE_DRIVE_USER_OUTSIDE_WORKSPACE=

# Google Drive personal (OAuth). Refresh token in .env.refresh_tokens.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_TEST_USER_EMAIL=
SECRET_KEY=

# Outlook (team / Microsoft 365, app-only). App registration needs write Application
# permissions + admin consent (Mail.ReadWrite, Mail.Send, User.Read.All, Group.Read.All,
# Group.ReadWrite.All, Directory.ReadWrite.All, User.ReadWrite.All; deleting the throwaway
# users also needs a directory role such as User Administrator). Pre-provision two licensed
# mailboxes and one M365 group with a mailbox; the suite starts its group conversations by
# mailing the group and removes them at teardown.
OUTLOOK_TEST_TENANT_ID=
OUTLOOK_TEST_CLIENT_ID=
OUTLOOK_TEST_CLIENT_SECRET=
OUTLOOK_TEST_USER_IDS=
OUTLOOK_TEST_GROUP_ID=
