# syntax=docker/dockerfile:1
# pipeshubai/pipeshub-ai-base — the slow layers the app image is built FROM.
# Build context: repository root (same as the root Dockerfile).
#
# Three targets, tagged by scripts/docker/base_tag.sh from a hash of this file,
# backend/python/uv.lock and backend/python/pyproject.toml:
#
#   python-deps-<hash>   site-packages, from the lockfile, plus NLTK, the
#                        fastembed BM25 model and Chromium. No embedding or
#                        reranker weights.
#   runtime-<hash>       apt runtime stack, Node 22, LibreOffice, Chromium's
#                        system libraries, cypher-shell. No Python packages.
#   models-bge-<hash>    python-deps plus BAAI/bge-large-en-v1.5 and
#                        BAAI/bge-reranker-base. Only the full app image copies
#                        this layer. Slim downloads those models on first use.
#
# A local build of the app image pulls python-deps first. That image is about
# 2 GB compressed because it holds the Python dependency set; it is cached
# after the first fetch. The app image itself does not rebuild it.
#
#   docker build -f Dockerfile.base --target python-deps -t pipeshubai/pipeshub-ai-base:python-deps .
#   docker build -f Dockerfile.base --target runtime-base -t pipeshubai/pipeshub-ai-base:runtime .
#   docker build -f Dockerfile.base --target models -t pipeshubai/pipeshub-ai-base:models-bge .
#
# CI publishes the hash tags (and, from main, the floating names above) to
# Docker Hub and GHCR. See .github/workflows/base-images.yml.

ARG PYTHON_IMAGE=python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ARG NODE_IMAGE=node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.22@sha256:9874eb7afe5ca16c363fe80b294fe700e460df29a55532bbfea234a0f12eddb1

# Default builds python-deps from scratch. Override with a previously published
# image so uv only installs what the lock added.
ARG PYTHON_DEPS_BASE=build-base

FROM ${UV_IMAGE} AS uv

# -----------------------------------------------------------------------------
# Build tools. Not copied into the runtime image.
# -----------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS build-base
ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Debian slim ships docker-clean, which wipes /var/cache/apt after installs.
RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    gnupg \
    wget \
    librocksdb-dev \
    libgflags-dev \
    libsnappy-dev \
    zlib1g-dev \
    libbz2-dev \
    liblz4-dev \
    libzstd-dev \
    libssl-dev \
    libspatialindex-dev \
    libmariadb-dev \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# /root/.rustup must live in the image layer, not a cache mount, or a later
# stage cannot run cargo when a dependency has no wheel.
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

COPY --from=uv /uv /uvx /bin/

# -----------------------------------------------------------------------------
# Target: python-deps — publish as pipeshubai/pipeshub-ai-base:python-deps-<hash>
# -----------------------------------------------------------------------------
FROM ${PYTHON_DEPS_BASE} AS python-deps
WORKDIR /app/python

COPY backend/python/pyproject.toml backend/python/uv.lock ./

# FASTEMBED_CACHE_PATH is set so fastembed writes somewhere the app image can
# copy. The default is /tmp, which the cleanup below deletes.
ENV FASTEMBED_CACHE_PATH=/root/.cache/fastembed \
    PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    PATCHRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    ORT_DISABLE_TELEMETRY=1

# Hashes come from uv.lock (uv export emits them unless --no-hashes is set).
# Git sources (etcd3) have no hash; the lock pins them to a commit, so they
# install separately with --no-deps and their dependencies stay hash-checked.
# --no-emit-project skips the application itself; the app image copies that
# source later and runs it from /app/python.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    rustup default stable && \
    uv export --frozen --no-dev --no-editable --no-emit-project --no-header --quiet -o /tmp/requirements.txt && \
    { grep -E '^[A-Za-z0-9_.-]+ @ git\+' /tmp/requirements.txt > /tmp/requirements-git.txt || true; } && \
    grep -vE '^[A-Za-z0-9_.-]+ @ git\+' /tmp/requirements.txt > /tmp/requirements-hashed.txt && \
    uv pip install --system --require-hashes -r /tmp/requirements-hashed.txt && \
    if [ -s /tmp/requirements-git.txt ]; then uv pip install --system --no-deps -r /tmp/requirements-git.txt; fi && \
    python -c "import nltk; nltk.download('punkt', quiet=True)" && \
    python -c "from langchain_qdrant import FastEmbedSparse; FastEmbedSparse(model_name='Qdrant/BM25')" && \
    python -m playwright install chromium && \
    python -m patchright install chromium && \
    rm -rf /tmp/*

# Preserves *.dist-info (importlib.metadata) and packages named "testing".
# Drops C/C++ headers and torch's cmake files, which nothing runs, and replaces
# the Node binary each browser driver vendors with a symlink. The runtime image
# has Node at /usr/bin/node; the symlink is dangling in this stage on purpose.
RUN set -eux; \
    find /usr/local/lib/python3.12/site-packages -type d -name tests -prune -exec rm -rf {} +; \
    find /usr/local/lib/python3.12/site-packages -type d -name __pycache__ -prune -exec rm -rf {} +; \
    find /usr/local/lib/python3.12/site-packages -type f -name '*.pyc' -delete; \
    find /usr/local/lib/python3.12/site-packages -type d -name include -prune -exec rm -rf {} +; \
    rm -rf /usr/local/lib/python3.12/site-packages/torch/share/cmake; \
    find /usr/local/lib/python3.12/site-packages -type f -name '*.so' -exec strip --strip-unneeded {} + 2>/dev/null || true; \
    for pkg in playwright patchright; do \
        drv="/usr/local/lib/python3.12/site-packages/${pkg}/driver/node"; \
        if [ -e "$drv" ] && [ ! -L "$drv" ]; then \
            rm -f "$drv"; \
            ln -s /usr/bin/node "$drv"; \
        fi; \
    done

# -----------------------------------------------------------------------------
# Target: models — publish as pipeshubai/pipeshub-ai-base:models-bge-<hash>
# Embedding and reranker weights. The slim app image does not copy this layer.
# -----------------------------------------------------------------------------
# The heron layout model is the pdfplumber parser's table and figure detector
# (app/modules/parsers/pdf/table_detector.py pins the same revision); slim
# downloads it on first use.
FROM python-deps AS models
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-large-en-v1.5', device='cpu')" && \
    python -c "from sentence_transformers import CrossEncoder; CrossEncoder(model_name='BAAI/bge-reranker-base')" && \
    python -c "from huggingface_hub import hf_hub_download; hf_hub_download('docling-project/docling-layout-heron-onnx', 'model.onnx', revision='40bde044036bb181c130ddf6c51792187268748f')"

# -----------------------------------------------------------------------------
# Target: runtime-base — publish as pipeshubai/pipeshub-ai-base:runtime-<hash>
# Apt packages land in runtime-apt; the published stage adds Node and cypher-shell.
# -----------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime-apt
ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libsnappy1v5 \
    zlib1g \
    liblz4-1 \
    libzstd1 \
    libpq5 \
    libmariadb3 \
    libgl1 \
    libglib2.0-0 \
    libreoffice-writer-nogui \
    libreoffice-calc-nogui \
    libreoffice-impress-nogui \
    fonts-noto-cjk \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libxshmfence1 \
    libx11-6 \
    libxcb1 \
    libxext6 \
    fonts-liberation \
    && if apt-cache show libasound2t64 >/dev/null 2>&1; then \
         apt-get install -y --no-install-recommends libasound2t64; \
       else \
         apt-get install -y --no-install-recommends libasound2; \
       fi \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Node from the official image, not NodeSource, so the runtime and the build
# stages run the same Node build.
FROM ${NODE_IMAGE} AS node-bins

FROM runtime-apt AS runtime-base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY --from=node-bins /usr/local/bin/node /usr/local/bin/node
COPY --from=node-bins /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ln -sf /usr/local/bin/node /usr/bin/node

# Neo4j's apt repo is the only published source for cypher-shell.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends gnupg && \
    curl -fsSL https://debian.neo4j.com/neotechnology.gpg.key | gpg --dearmor -o /usr/share/keyrings/neo4j.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/neo4j.gpg] https://debian.neo4j.com stable latest" > /etc/apt/sources.list.d/neo4j.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends cypher-shell && \
    apt-get purge -y --auto-remove gnupg && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
