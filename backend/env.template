# Driver connection pool per indexing event loop; match to the server's bolt
# thread pool. The indexing governor keeps in-flight records under this.
# NEO4J_MAX_CONNECTION_POOL_SIZE=100
# Real transactions (abort rolls back) instead of one auto-commit per query.
# Holds node locks until commit; soak on staging before enabling in production.
# NEO4J_EXPLICIT_TRANSACTIONS=false
# Even with the setting above off, creating an agent, a team or a knowledge base
# (including a user's default one) runs in one real transaction, so a failure
# partway leaves nothing half-made. Set to false to make these creates follow
# NEO4J_EXPLICIT_TRANSACTIONS again (one auto-commit per query while that is
# off), e.g. if their locks ever slow other writers down.
# NEO4J_CREATE_TRANSACTIONS=true

# Features that trade some compute or tokens per question for better answers.
# HIGH_ACCURACY_MODE turns all of them on; a feature's own switch, when set
# (true or false), decides for that feature alone. Named-entity extraction is
# the exception: its Labs flag can turn it on but not off under the mode.
# - GREP_RANK_FUSION: keyword (grep) hits from several commands are merged by
#   reciprocal rank fusion instead of each record's own match counts.
# - RELEVANCE_ORDERED_CONTEXT: knowledge-search results and first-turn context
#   show the most relevant record first instead of in record-id order.
# - FUSION_RECORD_CUT: each search asks the vector store for three times as
#   many hits (capped at 300) and keeps the requested number spread across
#   records, so one long document cannot fill the results. Tuning, read at
#   startup: SEARCH_FUSION_DEPTH (1-10, default 3), SEARCH_NEW_RECORD_SHARE
#   (0-1, default 0.5: the share of hits kept for records not yet shown), and
#   SEARCH_PER_RECORD_FLOOR / SEARCH_PER_RECORD_DIVISOR (default 4 / 6: one
#   record keeps at most max(floor, limit / divisor) of the first half).
# - ANSWER_COMPOSITION_RULES: enterprise-search answers name what they are
#   about and who said it, keep values with their qualifiers, answer a
#   procedure from the record that defines it, and settle conflicting sources
#   in a fixed order. Prompt text only.
# - THOROUGH_RETRIEVAL: enterprise search reads the records an answer rests
#   on in full, searches again for any part the context does not state, and
#   looks for other sources on a question about a conflict. More fetch and
#   search turns per question.
# - MULTI_STEP_ANSWER_RULES: every agent that can search knowledge gets rules
#   for questions that chain several lookups (confirm each constraint, search
#   with the entity a step resolved).
# - Named-entity extraction and the entity tools that read it (search_entities,
#   find_records_by_entity, find_records_by_value; Labs flag
#   ENABLE_NAMED_ENTITY_EXTRACTION): on under HIGH_ACCURACY_MODE whatever the
#   flag says. Extraction adds model calls while indexing, and only records
#   indexed after it is on gain entities. search_by_entities is not one of
#   them: it needs ENTITY_SEARCH_TOOL=true, below.
# HIGH_ACCURACY_MODE=false
# GREP_RANK_FUSION=
# RELEVANCE_ORDERED_CONTEXT=
# FUSION_RECORD_CUT=
# ANSWER_COMPOSITION_RULES=
# THOROUGH_RETRIEVAL=
# MULTI_STEP_ANSWER_RULES=

# ENTITY_SEARCH_TOOL=true offers the agent knowledgegraph__search_by_entities:
# it links the people, organizations, products or places a question names to
# the extracted named entities (one extra model call when a name is not an
# exact match) and searches the records that mention them. Off unless set,
# HIGH_ACCURACY_MODE included, and only where named-entity extraction is on.
# ENTITY_SEARCH_TOOL=

# KEYWORD_SEARCH_QUERIES=true tells the agent to write knowledge-search queries
# as keyword-dense text. Opt-in only: HIGH_ACCURACY_MODE does not turn it on.
# KEYWORD_SEARCH_QUERIES=

# Kill switches: on unless set to false. Not part of HIGH_ACCURACY_MODE.
# - FETCH_SIZE_BY_CHARS: knowledgegraph__fetch_record reads as much of each
#   record as fits a share of the model's context window (up to 140,000
#   characters per call), instead of a block count. The model's max_blocks is
#   honoured only when it continues a record. false restores the
#   58,000-character result and the 200-block cap on records that do not fit.
# FETCH_SIZE_BY_CHARS=


# Message broker: "kafka" or "redis" (uses Redis Streams)
MESSAGE_BROKER=redis

# Vector DB collection layout.
#   single              (default) every record in one collection, isolated by
#                       payload filters — the layout every provider recommends.
#   per_connector_type  one collection per connector type (drive_records,
#                       slack_records, ...). Gives each search a smaller
#                       collection and lets one source be re-indexed on its own;
#                       costs a fan-out across collections per search. Bounded
#                       by how many kinds of source you index (~30 at most).
# Changing this on an existing deployment is NOT a config edit: the services
# fail fast on startup, because points already sit in collections the new
# strategy would not resolve. Use the embedding-rebuild procedure.
# VECTOR_COLLECTION_STRATEGY=single

# KAFKA_BROKERS=localhost:9092
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512      # Options: plain, scram-sha-256, scram-sha-512
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_USERNAME is optional even with REDIS_PASSWORD set (Redis ACL default
# user has no name). Required for a Redis 6+ ACL that logs in as a named
# user, and for AWS MemoryDB IAM auth's username/password fallback.
# REDIS_USERNAME=
REDIS_URL=redis://:${REDIS_PASSWORD:-}@localhost:6379
# REDIS_DB is DEPRECATED and honoured only when REDIS_MODE=standalone (the
# default). It is rejected outright once REDIS_MODE is anything else, since
# neither Redis Cluster nor MemoryDB support SELECT-ing a database. Use
# REDIS_KEY_NAMESPACE below to isolate tenants/environments instead.
REDIS_DB=0
REDIS_TIMEOUT=10000
REDIS_KV_PREFIX=pipeshub:kv:
# REDIS_KEY_NAMESPACE isolates two deployments sharing one Redis/MemoryDB.
# It is applied by the explicit key builders -- the config KV store and its
# cache-invalidation pub/sub channel, the session/app cache, the
# accessible-records cache, retry counters, distributed leases, and the
# BullMQ crawling queue's hash tag.
# NOT applied to Redis Streams topic names (`records`, `record-events.N`) or
# consumer-group names. Because two deployments sharing one endpoint would
# then consume each other's messages, setting this together with
# MESSAGE_BROKER=redis is REJECTED at startup. Give the stream broker its own
# Redis/MemoryDB per deployment, or use MESSAGE_BROKER=kafka.
# REDIS_KEY_NAMESPACE=

# REDIS_MODE selects the connection provider: "standalone" (default, plain
# Redis) or "cluster" (Redis Cluster; also the protocol AWS MemoryDB
# speaks). Any other value must be registered by a REDIS_PROVIDER_MODULE
# (e.g. an EE MemoryDB provider with IAM auth) or startup fails fast.
# REDIS_MODE=standalone
# REDIS_CLUSTER_ENDPOINTS=host1:6379,host2:6379,host3:6379
# REDIS_PROVIDER_MODULE=
# REDIS_CLUSTER_SCALE_READS=master  # master | slave | all
# REDIS_CLUSTER_NAT_MAP remaps a cluster node's advertised CLUSTER
# SLOTS/SHARDS address to the address it is actually reachable at.
# Kubernetes-fronted self-hosted clusters and MemoryDB's private-VPC
# addressing both need this when the advertised address is not directly
# dialable from where this process runs. Comma-separated
# internalHost:internalPort=externalHost:externalPort entries.
# REDIS_CLUSTER_NAT_MAP=10.0.1.5:6379=cluster-node-1.example.com:6379

# TLS is off by default for local/plaintext Redis. AWS MemoryDB requires it;
# set these when REDIS_MODE=cluster (or memorydb) points at a TLS endpoint.
# Accepted values: true/1/yes/on and false/0/no/off (case-insensitive). Any
# other non-empty value fails startup rather than being guessed -- a typo here
# would otherwise silently mean plaintext, or unverified certificates.
# REDIS_TLS_REJECT_UNAUTHORIZED=false is refused outright when a Redis
# username/password is set: the connection would be encrypted but NOT
# authenticated, so the password is exposed to anyone who can intercept it.
# Point REDIS_TLS_CA_PATH at your CA instead of disabling verification.
# REDIS_TLS_ENABLED=false
# REDIS_TLS_REJECT_UNAUTHORIZED=true
# REDIS_TLS_CA_PATH=

# VECTOR_REDIS_MODE gates VECTOR_DB_TYPE=redis, defaulting to REDIS_MODE.
# FT.HYBRID needs Redis >= 8.4 in standalone mode, which MemoryDB does not
# ship -- but the vector store has its own REDIS_VECTOR_* connection, so
# app-on-MemoryDB with the vector index on a standalone Redis is valid:
# set this to "standalone" for that arrangement.
# VECTOR_REDIS_MODE=

# A record whose indexing event was lost -- never published because the send
# failed after the record was committed, or published and then dropped by the
# broker -- would otherwise sit QUEUED/NOT_STARTED forever: the stale scan only
# covers IN_PROGRESS. This sweep re-publishes such records. The value is the
# minimum age before a record is looked at; it does not need to be raised for a
# long backlog, because a record is left alone while the broker still holds
# older work on its lane, and each re-send doubles the wait before the next.
# 0 disables it.
# STRANDED_RECORD_REPUBLISH_AFTER_SECONDS=3600

# When a source rate-limits a record's content fetch and says when to come back
# (429 with Retry-After), indexing leaves the record QUEUED until then and the
# sweep above sends it again; no attempt is counted and no worker waits. This is
# the longest a record may wait in total before it is marked FAILED with the
# reason. 0 turns waiting off, as does disabling the sweep above.
# INDEXING_RATE_LIMIT_MAX_DEFER_SECONDS=86400

# Celery (backend/python/app/core/celery_app.py) has no Redis Cluster
# transport. When REDIS_MODE=cluster, set these to a separate, non-cluster
# broker/result-backend, or startup fails fast with this same message.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

MONGO_URI=mongodb://admin:password@localhost:27017/
MONGO_DB_NAME=enterprise-search

# Phase 2 one-time backfill: number of legacy `conversations` /
# `agentconversations` documents copied into chatSessions/chatSessionMessages
# per batch on Node boot. Runs in the background after the KB-filters
# migration completes; lower this if legacy documents are large enough that
# BATCH_SIZE x document size becomes memory pressure. Default: 10.
# CHAT_SESSIONS_MIGRATION_BATCH_SIZE=10

QDRANT_API_KEY=your_qdrant_secret_api_key
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_PORT=6333

OLLAMA_API_URL=http://localhost:11434

# Storage pattern match (query service, local blob storage). Its commands run
# under Landlock, confined to the records they may read. On a kernel without
# Landlock (older than 5.13, or Docker's seccomp profile before 20.10.10) both
# tools refuse to run; "true" runs them unconfined, relying on the command
# validator alone, and logs a warning each time.
# STORAGE_SEARCH_ALLOW_UNCONFINED=false
#
# Sandbox for agent-generated code (query service). No default: when unset or
# not one of the values below, the code-execution tools are left out of every
# chat and the rest of the service keeps working.
#   docker  each run in a throwaway container; needs a Docker daemon. This is
#           what deployment/docker-compose/*.yml and the Helm chart set.
#   e2b     off-host execution on E2B; needs E2B_API_KEY.
#   local   a subprocess of the query service with no isolation. Refused
#           unless SANDBOX_ALLOW_LOCAL=true is also set; single-user
#           development only, and logs a warning on use.
# SANDBOX_MODE=docker
# SANDBOX_ALLOW_LOCAL=false
#
# Network for generated code. Off by default: a prompt-injected document can
# steer what the agent writes. With docker, "true" lets code reach public
# addresses only: every container on the egress bridge installs a firewall that
# rejects private, CGNAT, link-local (cloud metadata) and bridge addresses
# before the code starts, then drops to an unprivileged user. The sandbox image
# must ship iptables; without it networked runs fall back to no network.
# SANDBOX_EGRESS_ALLOW_CIDRS (comma-separated IPv4) opens private ranges, e.g.
# an internal package mirror; link-local and metadata stay blocked.
# SANDBOX_ALLOW_NETWORK=false
# SANDBOX_EGRESS_ALLOW_CIDRS=
#
# Per-run writable-layer disk cap for docker-mode sandboxes, so one run cannot
# fill the host disk. Default 10g; set 0/off to disable. Enforced only on
# storage drivers that support it (overlay2 on xfs with the pquota mount
# option, or btrfs/zfs/devicemapper); where it is not enforceable the service
# logs a warning once and runs continue without a cap. Exceeding it fails a
# write with "no space left on device", not a killed run.
# SANDBOX_DISK_QUOTA=10g

ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=720h
# How long a forgot-password link works.
PASSWORD_RESET_LINK_EXPIRY=20m

# JWT / cookie signing secrets are generated with crypto.randomBytes(32) on
# first start and persisted at /services/secretKeys in the KV store. Values
# already in the store are never overwritten (rotation logs everyone out and
# breaks service-to-service tokens). To pre-seed a fresh install from a vault,
# set these before the first boot:
# JWT_SECRET=
# SCOPED_JWT_SECRET=
# COOKIE_SECRET=
# To replace secrets on an existing Docker Compose install:
#   ./install.sh --rotate-signing-secrets
# That writes a new ROTATE_SIGNING_SECRETS id; the app rotates once per id.


# Custom (non-catalog) MCP servers with the STDIO transport run the command an
# org admin types, on this host, as the service user, with its network access
# and the ability to read other same-user processes. Off unless "true", and set
# by the operator only (not an in-app setting). Catalog and remote (HTTP) MCP
# servers work either way. Export it for local MCP development.
# MCP_ALLOW_CUSTOM_STDIO=false

# MCP OAuth scopes (comma-separated)
MCP_SCOPES=openid,profile,email,offline_access,semantic:write,conversation:write,conversation:chat,kb:read,team:read,user:read,usergroup:read,config:read,agent:read,agent:execute,connector:read

# MCP servers added in Workspace -> MCP Servers
# Custom STDIO servers run a program on the connectors and query hosts, so enabling them lets
# administrators run code there; the checks below are guard rails, not a sandbox.
# MCP_ALLOW_CUSTOM_STDIO=false
# Launchers a custom STDIO server may use (comma-separated).
# MCP_STDIO_ALLOWED_COMMANDS=npx,uvx
# Administrators' servers may be on this deployment's network (RFC1918, ULA, CGNAT). Users' own
# servers, and URLs a server names in its OAuth metadata, are always public-only.
# MCP_ALLOW_PRIVATE_NETWORK_URLS=true
# Personal MCP servers each user may add.
# MCP_MAX_PERSONAL_INSTANCES=25
# How long an MCP server's tool list is kept between chats, in seconds (0 turns the cache off and
# every chat lists every attached server's tools again).
# MCP_TOOL_CACHE_TTL_SECONDS=86400
# How long a list the server calls "immediately stale" (ttlMs 0, what 2026-07-28 servers send
# unless they set a hint) is kept; it is re-checked before each chat's first call anyway.
# MCP_TOOL_CACHE_STALE_TTL_SECONDS=900
# The longest one MCP tool call may run, in seconds, while the server keeps reporting progress
# (each report restarts the server's call timeout). Never below that call timeout.
# MCP_TOOL_CALL_MAX_SECONDS=1800
# Sign in to MCP servers whose authorization server supports it with PipesHub's Client ID Metadata
# Document (served at <public address>/mcp-servers/oauth/client-metadata.json) instead of registering
# a client. Used only over https, once the document is found there; false always registers.
# MCP_OAUTH_CLIENT_METADATA_DOCUMENT=true

# When using Kafka, enable the kafka profile to start Kafka + Zookeeper containers:
#   COMPOSE_PROFILES=kafka
# When using Redis Streams, leave COMPOSE_PROFILES unset to skip Kafka/Zookeeper entirely.
# Redis Streams settings (only used when MESSAGE_BROKER=redis)
REDIS_STREAMS_MAXLEN=500000
# Indexing lanes on Redis Streams. Every service must use the same count.
FAIR_SCHEDULING_LANE_COUNT=8
# How a connector is given its lane: "assigned" (the least busy lane, recorded
# once in Redis, so connectors do not share a lane by chance) or "hash" (a hash
# of the connector id, as before). Set "hash" on every service to switch
# assigned lanes off.
# FAIR_SCHEDULING_LANE_ASSIGNMENT=assigned

# Consumer settings
# Max times a message can be delivered before being dead-lettered (default: 10)
# MAX_DELIVERY_ATTEMPTS=10

# SAML SP Entity ID (Issuer) — must match the Audience URI configured in your IdP.
# Defaults to FRONTEND_PUBLIC_URL if set, otherwise 'pipeshub'.
# SAML_SP_ENTITY_ID=

# Maximum concurrent blocking connector calls (default: 4)
CONNECTOR_THREAD_POOL_MAX_WORKERS=

# Public IPs connectors reach databases and APIs from (comma-separated), shown in
# connector setup forms for users to allow in their firewalls. Set it when traffic
# leaves through several NAT addresses; when empty the address is looked up once
# (api.ipify.org, then checkip.amazonaws.com) and the form hides it if that fails.
# "none" hides it without the lookup.
# CONNECTOR_EGRESS_IPS=

# Rate limiting.
# MAX_AUTH_REQUESTS_PER_MINUTE caps login, OTP and password requests per client IP.
# MAX_AUTH_REQUESTS_PER_MINUTE=10
#
# TRUST_PROXY tells the app which reverse proxies sit in front of it, so it can
# read the real client IP from X-Forwarded-For. Leave it unset when clients
# connect to PORT directly. Behind one proxy (nginx, Caddy, Traefik) use 1,
# or list the proxy addresses/CIDRs (e.g. 172.16.0.0/12). Never use "true":
# clients could then pick their own IP and bypass rate limits.
# TRUST_PROXY=
