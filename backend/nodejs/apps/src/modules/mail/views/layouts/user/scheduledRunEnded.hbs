<!DOCTYPE html>
<html>
  {{>head}}
  <body>
    <main>
      <table {{{containerstyle}}}>
        <tr>
          <td>{{> header}}</td>
        </tr>
        <tr>
          <td>
            <table class="mobile-width" {{{bodytablestyle}}}>
              <tr>
                <td
                  style="
                    padding: 40px 30px;
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                  "
                >
                  <div
                    style="
                      font-size: 20px;
                      font-weight: 700;
                      color: #1d1c1d;
                      letter-spacing: -0.25px;
                      line-height: 28px;
                      margin: 0 0 16px 0;
                    "
                  >
                    {{outcome}}
                  </div>
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                      margin: 0 0 24px 0;
                    "
                  >
                    <div>Hi {{name}},</div>
                    <div style="height: 22px; line-height: 22px;">&nbsp;</div>
                    <div>Your schedule <strong>{{scheduleName}}</strong> ran.
                      Open the conversation to see what it did:
                      <a href="{{link}}">{{link}}</a></div>
                    <div style="height: 22px; line-height: 22px;">&nbsp;</div>
                    <div>You get this email because you chose email notices
                      for this schedule. Change that in Schedules.</div>
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>{{> footer}}</td>
        </tr>
      </table>
    </main>
  </body>
</html>
