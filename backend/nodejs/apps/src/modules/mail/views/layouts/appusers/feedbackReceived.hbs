<!DOCTYPE html>
<html>
  {{>head}}
  <body>
    <main>
      <table {{{containerstyle}}}>
        <tr>
          <td>{{> header}}</td>
        </tr>
        <tr>
          <td>
            <table class="mobile-width" {{{bodytablestyle}}}>
              <tr>
                <td
                  style="
                    padding: 40px 30px;
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                  "
                >
                  <div
                    style="
                      font-size: 20px;
                      font-weight: 500;
                      color: #1d1c1d;
                      letter-spacing: -0.25px;
                      line-height: 28px;
                      margin: 0 0 16px 0;
                    "
                  >
                    New {{kindLabel}}
                  </div>
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                      margin: 0 0 16px 0;
                    "
                  >
                    <strong style="font-weight: 700;">{{userName}}</strong>
                    ({{userEmail}}) from
                    &ldquo;<strong style="font-weight: 700;">{{orgName}}</strong>&rdquo;
                    submitted {{kindLabel}}.
                  </div>
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                      margin: 0 0 16px 0;
                      white-space: pre-wrap;
                    "
                  >
                    {{description}}
                  </div>
                  <div
                    style="
                      font-size: 13px;
                      font-weight: 400;
                      color: #696969;
                      line-height: 20px;
                    "
                  >
                    Attachments: {{attachmentCount}} · Submitted: {{submittedAt}}
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>{{> footer}}</td>
        </tr>
      </table>
    </main>
  </body>
</html>
