<!DOCTYPE html>
<html>
  {{>head}}
  <body>
    <main>
      <table {{{containerstyle}}}>
        <tr>
          <td>{{> header}}</td>
        </tr>
        <tr>
          <td>
            <table class="mobile-width" {{{bodytablestyle}}}>
              <tr>
                <td
                  style="
                    padding: 40px 30px;
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                  "
                >
                  <div
                    style="
                      font-size: 20px;
                      font-weight: 500;
                      color: #1d1c1d;
                      letter-spacing: -0.25px;
                      line-height: 28px;
                      margin: 0 0 16px 0;
                    "
                  >
                    {{#if reconnect}}Reconnect{{else}}Connect{{/if}} your
                    <strong style="font-weight: 700;">{{sourceName}}</strong>
                    account
                  </div>
                  {{#if inviterName}}
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                      margin: 0 0 16px 0;
                    "
                  >
                    <strong style="font-weight: 700;">{{inviterName}}</strong>
                    {{#if orgName}}from {{orgName}} {{/if}}asked you to connect
                    your {{sourceName}} account.
                  </div>
                  {{/if}}
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                      margin: 0 0 16px 0;
                    "
                  >
                    {{productName}} will show you the {{sourceName}} pages you choose,
                    in search and chat. You pick the pages in {{sourceName}};
                    their sub-pages are included.
                  </div>
                  {{#if connectorName}}
                  <div
                    style="
                      font-size: 13px;
                      font-weight: 400;
                      color: #616061;
                      line-height: 20px;
                      margin: 0 0 16px 0;
                    "
                  >
                    Connector: {{connectorName}}
                  </div>
                  {{/if}}
                  <div style="margin: 24px 0 24px 0;">
                    <a
                      href="{{{link}}}"
                      target="_blank"
                      style="
                        display: inline-block;
                        background-color: #006949;
                        color: #ffffff;
                        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        font-size: 16px;
                        font-weight: 500;
                        line-height: 24px;
                        text-decoration: none;
                        padding: 8px 16px;
                        border-radius: 3px;
                      "
                    >Connect {{sourceName}}</a>
                  </div>
                  <div
                    style="
                      font-size: 13px;
                      font-weight: 400;
                      color: #616061;
                      line-height: 20px;
                    "
                  >
                    This link works for {{expiresInDays}} days.
                    <a
                      href="{{{optOutLink}}}"
                      target="_blank"
                      style="color: #616061; text-decoration: underline;"
                    >Don&rsquo;t remind me</a>
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>{{> footer}}</td>
        </tr>
      </table>
    </main>
  </body>
</html>
