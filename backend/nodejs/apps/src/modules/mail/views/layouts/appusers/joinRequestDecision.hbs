<!DOCTYPE html>
<html>
  {{>head}}
  <body>
    <main>
      <table {{{containerstyle}}}>
        <tr>
          <td>{{> header}}</td>
        </tr>
        <tr>
          <td>
            <table class="mobile-width" {{{bodytablestyle}}}>
              <tr>
                <td
                  style="
                    padding: 40px 30px;
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                  "
                >
                  {{#if approved}}
                  <div
                    style="
                      font-size: 20px;
                      font-weight: 500;
                      color: #1d1c1d;
                      letter-spacing: -0.25px;
                      line-height: 28px;
                      margin: 0 0 16px 0;
                    "
                  >
                    Your request to join
                    <strong style="font-weight: 700;">{{orgName}}</strong>
                    was approved
                  </div>
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                      margin: 0 0 40px 0;
                    "
                  >
                    You can now sign in and access this workspace.
                  </div>
                  <div style="margin: 0 0 40px 0;">
                    <a
                      href="{{{link}}}"
                      target="_blank"
                      style="
                        display: inline-block;
                        background-color: #006949;
                        color: #ffffff;
                        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        font-size: 16px;
                        font-weight: 500;
                        line-height: 24px;
                        text-decoration: none;
                        padding: 8px 16px;
                        border-radius: 3px;
                      "
                    >Sign in</a>
                  </div>
                  {{else}}
                  <div
                    style="
                      font-size: 20px;
                      font-weight: 500;
                      color: #1d1c1d;
                      letter-spacing: -0.25px;
                      line-height: 28px;
                      margin: 0 0 16px 0;
                    "
                  >
                    Your request to join
                    <strong style="font-weight: 700;">{{orgName}}</strong>
                    was declined
                  </div>
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #434245;
                      line-height: 22px;
                    "
                  >
                    A workspace admin declined this request. You can ask to join
                    again later if needed.
                  </div>
                  {{/if}}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>{{> footer}}</td>
        </tr>
      </table>
    </main>
  </body>
</html>
