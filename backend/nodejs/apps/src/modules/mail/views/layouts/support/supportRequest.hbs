<!DOCTYPE html>
<html>
  {{>head}}
  <body>
    <main>
      <table {{{containerstyle}}}>
        <tr>
          <td>{{> header}}</td>
        </tr>
        <tr>
          <td>
            <table class="mobile-width" {{{bodytablestyle}}}>
              <tr>
                <td
                  style="
                    padding: 24px 30px 32px 30px;
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                  "
                >
                  <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                      width: 100%;
                      border-collapse: separate;
                      border-spacing: 0;
                      background-color: #006949;
                      border-radius: 8px;
                    "
                  >
                    <tr>
                      <td style="padding: 18px 20px;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%;">
                          <tr>
                            <td style="font-size: 12px; font-weight: 700; line-height: 20px; color: #ffffff; vertical-align: middle;">
                              {{#if forRequester}}Support request received{{else}}New support request{{/if}}
                            </td>
                            <td align="right" style="text-align: right; vertical-align: middle;">
                              <span
                                style="
                                  display: inline-block;
                                  padding: 2px 8px;
                                  border-radius: 4px;
                                  background-color: #298166;
                                  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
                                  font-size: 13px;
                                  line-height: 20px;
                                  color: #ffffff;
                                "
                              >{{reference}}</span>
                            </td>
                          </tr>
                          <tr>
                            <td
                              colspan="2"
                              style="
                                padding-top: 8px;
                                font-size: 20px;
                                font-weight: 700;
                                line-height: 26px;
                                letter-spacing: -0.2px;
                                color: #ffffff;
                              "
                            >
                              {{#if forRequester}}We've got your request{{else}}{{issue}}{{/if}}
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                  {{#if forRequester}}
                    <div
                      style="
                        font-size: 15px;
                        font-weight: 400;
                        color: #434245;
                        line-height: 24px;
                        margin: 20px 0 0 0;
                      "
                    >
                      Our team will reply to this address. Quote
                      <strong style="font-weight: 700; color: #1d1c1d;">{{reference}}</strong>
                      if you follow up.
                    </div>
                  {{else}}
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 20px 0 0 0;">
                      <tr>
                        <td
                          width="40"
                          height="40"
                          align="center"
                          valign="middle"
                          style="
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background-color: #e3f3ec;
                            color: #006949;
                            font-size: 14px;
                            font-weight: 700;
                            line-height: 40px;
                            text-align: center;
                          "
                        >{{userInitials}}</td>
                        <td style="padding-left: 12px; vertical-align: middle;">
                          <div style="font-size: 15px; font-weight: 700; line-height: 20px; color: #1d1c1d;">
                            {{userName}}
                            <span
                              style="
                                display: inline-block;
                                margin-left: 6px;
                                padding: 0 6px;
                                border: 1px solid #d5d5d5;
                                border-radius: 4px;
                                font-size: 12px;
                                font-weight: 400;
                                line-height: 18px;
                                color: #434245;
                                vertical-align: 1px;
                              "
                            >{{userRole}}</span>
                          </div>
                          <div style="font-size: 13px; line-height: 20px; color: #60646c; margin-top: 2px;">
                            {{#if userEmail}}<a href="mailto:{{userEmail}}" style="color: #1264a3;">{{userEmail}}</a> &middot; {{/if}}{{orgName}}
                          </div>
                        </td>
                      </tr>
                    </table>
                  {{/if}}
                  <div
                    style="
                      font-size: 12px;
                      font-weight: 700;
                      color: #60646c;
                      line-height: 16px;
                      margin: 24px 0 0 0;
                    "
                  >
                    {{#if forRequester}}What you sent{{else}}Message{{/if}}
                  </div>
                  <div
                    style="
                      font-size: 15px;
                      font-weight: 400;
                      color: #1d1c1d;
                      line-height: 24px;
                      background-color: #f4f6f5;
                      border-radius: 8px;
                      padding: 16px 18px;
                      margin: 8px 0 0 0;
                      white-space: pre-wrap;
                    "
                  >{{description}}</div>
                  {{#each groups}}
                    <div
                      style="
                        font-size: 13px;
                        font-weight: 700;
                        color: #1d1c1d;
                        line-height: 18px;
                        border-bottom: 1px solid #c9c9c9;
                        padding-bottom: 6px;
                        margin: {{#if @first}}28px{{else}}20px{{/if}} 0 0 0;
                      "
                    >
                      {{title}}
                    </div>
                    <table
                      role="presentation"
                      width="100%"
                      cellspacing="0"
                      cellpadding="0"
                      border="0"
                      style="
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 14px;
                        color: #1d1c1d;
                        line-height: 20px;
                      "
                    >
                      {{#each rows}}
                        <tr>
                          <td style="padding: 10px 16px 10px 0; width: 134px; font-size: 13px; color: #60646c; vertical-align: top;{{#unless @last}} border-bottom: 1px solid #ececec;{{/unless}}">{{label}}</td>
                          <td style="padding: 10px 0; vertical-align: top; word-break: break-word;{{#unless @last}} border-bottom: 1px solid #ececec;{{/unless}}">{{value}}</td>
                        </tr>
                      {{/each}}
                    </table>
                  {{/each}}
                  <div
                    style="
                      font-size: 12px;
                      font-weight: 400;
                      color: #60646c;
                      line-height: 18px;
                      margin: 20px 0 0 0;
                    "
                  >
                    Submitted {{submittedAt}}
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>{{> footer}}</td>
        </tr>
      </table>
    </main>
  </body>
</html>
