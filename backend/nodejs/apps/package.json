{
  "name": "es-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && node dist/scripts/write-build-info.js",
    "dev": "nodemon src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "cross-env TS_NODE_PROJECT=tsconfig.test.json c8 mocha --parallel --jobs 4",
    "test:coverage": "cross-env TS_NODE_PROJECT=tsconfig.test.json c8 --reporter=text --reporter=lcov --reporter=html mocha",
    "test:ci": "cross-env TS_NODE_PROJECT=tsconfig.test.json c8 --check-coverage --lines 89 --functions 90 --branches 80 --statements 89 --reporter=text --reporter=lcov mocha --parallel --jobs 4",
    "test:coverage-check": "cross-env TS_NODE_PROJECT=tsconfig.test.json c8 --check-coverage --lines 89 --functions 90 --branches 80 --statements 89 --reporter=text --reporter=html --reporter=json-summary mocha --parallel --jobs 4",
    "test:notification": "cross-env TS_NODE_PROJECT=tsconfig.test.json mocha --grep 'notification/(routes|service/notification\\.consumer)' --timeout 15000",
    "slack": "nodemon src/integrations/slack-bot/src/index.ts"
  },
  "keywords": [],
