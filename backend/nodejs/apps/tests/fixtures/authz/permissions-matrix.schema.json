{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Permissions golden matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rows"],
  "properties": {
    "version": { "const": 1 },
    "rows": { "type": "array", "items": { "$ref": "#/definitions/row" } }
  },
  "definitions": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decider", "since", "given", "action", "expect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "decider": { "type": "string", "minLength": 1 },
        "since": { "type": "string", "pattern": "^PH-[0-9]{2}$" },
        "langs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ts", "py", "fe"] }
        },
        "given": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal", "resource", "grants"],
          "properties": {
            "principal": { "type": "string", "minLength": 1 },
            "resource": { "type": "string", "minLength": 1 },
            "grants": { "type": "array", "items": { "type": "object" } }
          }
        },
        "action": { "type": "string", "minLength": 1 },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": { "type": "boolean" },
            "role": { "type": "string" },
            "code": { "type": "string" }
          }
        }
      }
    }
  }
}
