{
  "description": "Header names that may carry a credential. Node (maskConfigSecrets.ts CREDENTIAL_HEADER_HINT) and Python (model_identity/preview.py CREDENTIAL_HEADER_HINT) must use this pattern, case-insensitive, and classify these names alike.",
  "pattern": "auth|cookie|key|token|secret|password|credential|signature|assertion",
  "credential": [
    "Authorization",
    "Proxy-Authorization",
    "Cookie",
    "x-api-key",
    "X-Goog-Api-Key",
    "Ocp-Apim-Subscription-Key",
    "x-functions-key",
    "X-Key",
    "x-access-token",
    "x-client-secret",
    "x-password",
    "x-amz-security-token",
    "x-signature",
    "x-client-assertion",
    "x-credential",
    "X-Credentials"
  ],
  "notCredential": [
    "x-litellm-end-user-id",
    "x-user-email",
    "x-request-id",
    "x-trace-id",
    "x-org"
  ]
}
