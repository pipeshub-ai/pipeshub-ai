{
  "_comment": "Hand-maintained size/thinking rules per model family, first match wins. Patterns match families, not exact ids, so new versions still match. Read by app/services/ai_models/traits.py.",
  "rules": [
    {"match": "gpt-oss-?120b", "size": "large", "thinking": "optional"},
    {"match": "gpt-oss-?20b", "size": "medium", "thinking": "optional"},
    {"match": "gpt-[0-9.]+-?(nano|mini)", "size": "small"},
    {"match": "gpt-[0-9.]+-luna", "size": "small"},
    {"match": "gpt-[0-9.]+-terra", "size": "medium"},
    {"match": "gpt-[0-9.]+-(sol|astra)", "size": "large"},
    {"match": "gpt-5[^/]*-chat", "size": "medium", "thinking": "none"},
    {"match": "gpt-5(\\.[0-9]+)?(-pro)?($|[^a-z0-9])", "size": "large"},
    {"match": "gpt-4\\.1-(nano|mini)|gpt-4o-mini", "size": "small", "thinking": "none"},
    {"match": "gpt-4(o|\\.1)", "size": "medium", "thinking": "none"},
    {"match": "(^|[^a-z])o[134](-mini)", "size": "small", "thinking": "always"},
    {"match": "(^|[^a-z])o[134]($|[^a-z0-9])", "size": "large", "thinking": "always"},
    {"match": "claude[^/]*haiku", "size": "small"},
    {"match": "claude[^/]*sonnet", "size": "medium"},
    {"match": "claude[^/]*opus-5-5", "size": "large", "thinking": "always"},
    {"match": "claude[^/]*(opus|fable)", "size": "large"},
    {"match": "gemini[^/]*flash-lite", "size": "small"},
    {"match": "gemini-(3|[4-9])[^/]*flash", "size": "medium", "thinking": "always"},
    {"match": "gemini[^/]*flash", "size": "medium"},
    {"match": "gemini-(2\\.5|3|[4-9])[^/]*pro", "size": "large", "thinking": "always"},
    {"match": "gemini[^/]*pro", "size": "large"},
    {"match": "grok[^/]*(mini|fast)", "size": "small"},
    {"match": "grok-4", "size": "large", "thinking": "always"},
    {"match": "(ministral|mistral-small|mistral-tiny)", "size": "small"},
    {"match": "mistral-medium", "size": "medium"},
    {"match": "(mistral-large|magistral)", "size": "large"},
    {"match": "deepseek[^/]*(reasoner|r1)", "size": "large", "thinking": "always"},
    {"match": "deepseek[^/]*flash", "size": "small"},
    {"match": "deepseek", "size": "large"},
    {"match": "command-r7b|command-light", "size": "small"},
    {"match": "command-a|command-r-plus", "size": "large"},
    {"match": "qwen3", "thinking": "optional"}
  ]
}
