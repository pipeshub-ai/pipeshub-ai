    {
      "id": "openai-chatgpt-workspace-token",
      "provider": "openai",
      "accountKind": "user_plan_injected",
      "route": "vendor_injected",
      "engines": [
        "codex"
      ],
      "offering": [
        "managed",
        "oss"
      ],
      "status": "pending_vendor",
      "consumer": true,
      "source": "https://learn.chatgpt.com/docs/enterprise/access-tokens",
      "note": "ChatGPT Business/Enterprise Codex access tokens: allowed for trusted runners; whether a platform may store them is pending OpenAI"
    },
    {
      "id": "openai-chatgpt-siwc-gateway",
      "provider": "openai",
      "accountKind": "user_plan_injected",
      "route": "gateway",
      "engines": [
        "codex"
      ],
      "offering": [
        "managed",
        "oss"
      ],
      "status": "pending_vendor",
      "consumer": true,
      "source": "https://developers.openai.com/siwc/request-client-id",
      "note": "ChatGPT plan via Sign in with ChatGPT, its token used by PipesHub's gateway (never in the sandbox): offered only to OpenAI's commercial partners, pending in every offering until OpenAI's written yes"
    },
    {
      "id": "openai-codex-app-server-login",
      "provider": "openai",
      "accountKind": "user_plan_sandbox_login",
      "route": "vendor_sandbox_login",
      "engines": [
        "codex"
      ],
      "offering": [
        "managed",
        "oss"
      ],
      "status": "prohibited",
      "consumer": true,
      "source": "https://learn.chatgpt.com/docs/app-server (Auth endpoints: \"App-server authentication has never been permitted for commercial or hosted services.\")",
      "note": "The person's own ChatGPT login inside Codex in the sandbox (codex login, app-server login): do not use"
    },
    {
      "id": "openai-codex-chatgpt-auth-tokens",
      "provider": "openai",
      "accountKind": "user_plan_injected",
      "route": "vendor_sandbox_login",
      "engines": [
        "codex"
      ],
      "offering": [
        "managed",
        "oss"
      ],
      "status": "prohibited",
      "consumer": true,
      "source": "https://learn.chatgpt.com/docs/app-server (Auth endpoints: \"App-server authentication has never been permitted for commercial or hosted services.\")",
      "note": "Codex app-server chatgptAuthTokens mode (a ChatGPT login PipesHub holds, handed to the engine in the sandbox): do not use"
    },
