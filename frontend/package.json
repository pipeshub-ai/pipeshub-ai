{
  "name": "pipeshub",
  "version": "0.1.0",
  "description": "PipesHub Desktop App",
  "author": "PipesHub",
  "homepage": "https://github.com/pipeshub-ai/pipeshub-ai",
  "private": true,
  "main": "electron/compile/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "i18n:keys": "node scripts/check-i18n-keys.mjs",
    "test:i18n": "node --test scripts/check-i18n-parity.test.mjs scripts/check-i18n-keys.test.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "deploy:dev": "bash scripts/deploy-dev.sh",
    "test:text-fragments": "playwright test -c playwright.text-fragments.config.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test --grep @smoke",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:seed": "npx playwright test --project=seed",
    "test:e2e:users": "npx playwright test tests/e2e/users/",
    "test:e2e:groups": "npx playwright test tests/e2e/groups/",
    "test:e2e:teams": "npx playwright test tests/e2e/teams/",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:cleanup": "npx playwright test tests/e2e/seed/cleanup.spec.ts --project=seed",
    "test:e2e:coverage": "COVERAGE=true npx playwright test",
    "test:e2e:coverage-report": "npx open-cli coverage/e2e/report.html",
    "build:electron": "node scripts/electron/next-build-electron.mjs",
    "build:electron:typescript": "tsc -p electron/tsconfig.json",
    "electron:prepare": "npm run build:electron:typescript && node scripts/electron/electron-prepare.mjs",
    "electron:build:mac": "node scripts/electron/build.mjs mac",
    "electron:build:win": "node scripts/electron/build.mjs win",
    "electron:build:linux": "node scripts/electron/build.mjs linux",
    "electron:build:all": "node scripts/electron/build.mjs all",
    "_comment:test:electron": "Two things here are load-bearing. --test-concurrency=1: the local-sync tests drive real fs watchers against real temp directories, and node --test runs files in parallel by default, which makes them interfere and hang. Unquoted, single-star patterns: the shell has to expand them, because CI runs Node 20, whose test runner does not glob and would treat a quoted pattern or a ** as a literal path.",
    "test:electron": "npm run build:electron:typescript && node --test --test-concurrency=1 electron/compile/__tests__/*.test.js electron/compile/local-sync/__tests__/*.test.js"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.30",
    "@azure/msal-browser": "^5.26.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@radix-ui/themes": "^3.3.0",
    "@react-oauth/google": "^0.13.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "chokidar": "^3.6.0",
    "dayjs": "^1.11.23",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.2.7",
    "katex": "^0.19.0",
    "lottie-react": "^2.4.1",
    "mermaid": "^11.16.1",
    "nanoid": "^6.0.2",
    "next": "^15.5.28",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-pdf-highlighter": "^7.0.0",
    "react-player": "^3.4.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.4",
    "swr": "^2.5.1",
    "tiptap-markdown": "^0.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.2.2",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "monocart-reporter": "^2.15.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "text-fragments-polyfill": "^6.7.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "katex": "$katex"
  }
}
